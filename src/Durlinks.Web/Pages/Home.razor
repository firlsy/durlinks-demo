@page "/"
@using Durlinks.Shared.DTOs
@using Durlinks.Shared.Enums
@using Durlinks.Web.Services
@implements IDisposable
@inject SearchService Search
@inject IJSRuntime JS

<PageTitle>链接仓库 · 搜索</PageTitle>

<div class="hero">
    <h1>🔗 链接仓库</h1>
    <p>搜索、筛选、收藏 —— 所有链接一目了然</p>
</div>

@if (libraries.Count > 0)
{
    <div class="lib-tabs" role="group" aria-label="发布库筛选">
        <button type="button" class="lib-tab @(selLibrary is null ? "on" : "")" @onclick="()=>SelectLibrary(null)">全部</button>
        @foreach (var lib in libraries)
        {
            <button type="button" class="lib-tab @(selLibrary == lib.Id ? "on" : "")" @onclick="()=>SelectLibrary(lib.Id)">@lib.Name</button>
        }
        @if (selLibrary.HasValue || !string.IsNullOrWhiteSpace(keyword))
        {
            <span class="lib-hint">@(selLibrary.HasValue ? $"当前库：{CurrentLibraryName} · " : "")搜索条件已保留</span>
        }
    </div>
}

<div class="search-bar">
    <input class="search-input" placeholder="搜索名称、链接、摘要…" @bind="keyword" @bind:event="oninput" @bind:after="OnSearchChanged" />
    <select class="filter-select" @bind="selGroup" @bind:after="OnSearchChanged">
        <option value="">全部分组</option>
        @foreach (var g in filters.Groups) { <option value="@g">@g</option> }
    </select>
    <select class="filter-select" @bind="selTag" @bind:after="OnSearchChanged">
        <option value="">全部标签</option>
        @foreach (var t in filters.Tags) { <option value="@t">@t</option> }
    </select>
    <select class="filter-select" @bind="selPlatform" @bind:after="OnSearchChanged">
        <option value="">全部平台</option>
        @foreach (var p in filters.Platforms) { <option value="@p">@p</option> }
    </select>
    <select class="filter-select" @bind="selSource" @bind:after="OnSearchChanged">
        <option value="">全部来源</option>
        <option value="0">人工导入</option>
        <option value="1">AI接入</option>
    </select>
</div>

@if (loading)
{
    <p class="status">加载中…</p>
}
else if (result is null)
{
    <p class="status">未能连接后端，请稍后重试。</p>
}
else
{
    <p class="status">共 <b>@result.Total</b> 条结果 · 第 @result.Page/@Math.Max(1, result.TotalPages) 页
        @if (selLibrary.HasValue) { <span class="status-lib"> · @CurrentLibraryName</span> }
        @if (!string.IsNullOrWhiteSpace(keyword)) { <span class="status-lib"> · 关键词「@keyword」</span> }
    </p>

    <div class="cards">
        @foreach (var item in result.Items)
        {
            <article class="card">
                <div class="card-row1">
                    <h3 class="card-title">@item.Title</h3>
                    <div class="urls">
                        @foreach (var u in AllUrls(item))
                        {
                            <a href="@u" target="_blank" rel="noopener" class="url-link">@Short(u)</a>
                        }
                    </div>
                    <div class="meta">
                        <span class="tag type-tag">@item.LinkType</span>
                        <span class="tag group">@item.GroupName</span>
                        @if (!string.IsNullOrEmpty(item.Platform)) { <span class="tag platform">@item.Platform</span> }
                        @if (!string.IsNullOrEmpty(item.Version)) { <span class="tag version">@item.Version</span> }
                    </div>
                    <span class="source-badge @(item.ImportSource == ImportSource.AiImported ? "ai" : "manual")">@item.ImportSourceLabel</span>
                </div>

                <div class="card-row2">
                    @if (!string.IsNullOrEmpty(item.Summary))
                    {
                        <p class="summary">@item.Summary</p>
                    }
                    @if (!string.IsNullOrEmpty(item.ExtractCode))
                    {
                        <div class="detail">提取码：<code>@item.ExtractCode</code>
                            <button type="button" class="copy-btn" @onclick="() => Copy(item.ExtractCode!)">复制</button>
                            @if (!string.IsNullOrEmpty(item.ExpireAt)) { <span class="detail"> · 过期：@item.ExpireAt</span> }
                        </div>
                    }
                    @if (item.SubLinks.Count > 0)
                    {
                        <div class="sublinks">
                            <span class="sub-label">附属链接：</span>
                            @foreach (var s in item.SubLinks)
                            {
                                <a href="@s.Url" target="_blank" rel="noopener">@(s.Title ?? Short(s.Url))</a>
                            }
                        </div>
                    }
                    @if (item.Tags.Count > 0)
                    {
                        <div class="tags-row">
                            @foreach (var t in item.Tags) { <span class="mini-tag">#@t</span> }
                        </div>
                    }
                </div>
            </article>
        }
    </div>

    @if (result.TotalPages > 1)
    {
        <div class="pager">
            <button disabled="@(page <= 1)" @onclick="() => Goto(page - 1)">上一页</button>
            <span>@(page) / @result.TotalPages</span>
            <button disabled="@(page >= result.TotalPages)" @onclick="() => Goto(page + 1)">下一页</button>
        </div>
    }
}

@code {
    private string keyword = "";
    private string selGroup = "";
    private string selTag = "";
    private string selPlatform = "";
    private string selSource = "";
    private int page = 1;
    private const int PageSize = 20;
    private bool loading = true;
    private PagedResult<LinkDto>? result;
    private FilterOptionsDto filters = new();
    private System.Threading.Timer? debounce;

    private List<LibraryDto> libraries = [];
    private int? selLibrary;
    private string CurrentLibraryName => selLibrary.HasValue
        ? libraries.FirstOrDefault(x => x.Id == selLibrary.Value)?.Name ?? "发布库"
        : "全部发布库";

    protected override async Task OnInitializedAsync()
    {
        try { libraries = await Search.GetLibrariesAsync(); } catch { }
        try { filters = await Search.GetFiltersAsync() ?? new FilterOptionsDto(); }
        catch { /* 后端未启动时静默 */ }
        await LoadAsync();
    }

    private async Task SelectLibrary(int? id)
    {
        selLibrary = id;
        page = 1;
        await LoadAsync();
    }

    private IEnumerable<string> AllUrls(LinkDto item)
    {
        var list = new List<string>();
        if (!string.IsNullOrEmpty(item.Url)) list.Add(item.Url);
        foreach (var u in item.Urls)
            if (!list.Contains(u)) list.Add(u);
        return list;
    }

    private static string Short(string url) => url.Length > 60 ? url[..60] + "…" : url;

    private async Task Copy(string text)
    {
        try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", text); } catch { }
    }

    private void OnSearchChanged()
    {
        page = 1;
        debounce?.Dispose();
        debounce = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(LoadAsync);
        }, null, 300, System.Threading.Timeout.Infinite);
    }

    private async Task Goto(int p) { page = p; await LoadAsync(); }

    private async Task LoadAsync()
    {
        loading = true;
        StateHasChanged();
        try
        {
            ImportSource? src = string.IsNullOrEmpty(selSource) ? null : (ImportSource)int.Parse(selSource);
            result = await Search.SearchAsync(new LinkQuery
            {
                Q = keyword, Group = selGroup, Tag = selTag, Platform = selPlatform,
                ImportSource = src, LibraryId = selLibrary, Channel = "web",
                Page = page, PageSize = PageSize
            });
        }
        catch { result = null; }
        loading = false;
        StateHasChanged();
    }

    public void Dispose() => debounce?.Dispose();
}
