    private bool libDelOpen, libDelBusy;
    private LibraryDto? libDelTarget;
    private string libDelPwd = "", libDelMsg = "";
    // 链接去重
    private bool dedupeOpen, dedupeBusy, dedupeAll;
    private DedupeResult? dedupeResult;
    private string? dedupeMsg;
