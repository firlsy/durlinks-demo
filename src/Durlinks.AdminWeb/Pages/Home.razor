    protected override async Task OnParametersSetAsync()
    {
        var raw = (Section ?? string.Empty).Trim().ToLowerInvariant();
        var target = raw switch
        {
            "publish" or "links" => "publish",
            "users" => "users",
            "categories" => "categories",
            "llm" => "llm",
            "account" => "account",
            _ => "dashboard"
        };
        // 未知后缀统一落到看板，并纠正地址栏
        if (raw is not ("" or "dashboard" or "publish" or "links" or "users" or "categories" or "llm" or "account"))
            Nav.NavigateTo("dashboard", replace: true);

        if (sectionApplied && view == target) return;
        view = target;
        sectionApplied = true;
        if (!loggedIn) return; // 首屏等 OnAfterRender 里读完 token 再加载

        await ApplySectionAsync(target);
    }

    /// <summary>按当前功能加载所需数据（发布管理要拉发布库+链接，账号设置要拉 MFA 状态）。</summary>
    private async Task ApplySectionAsync(string target)
    {
        if (target == "publish")
        {
            await LoadLibraries();
            if (currentLibId is null && libraries.Count > 0) await SelectLibrary(libraries[0].Id);
            else await LoadLinks();
        }
        else if (target == "categories")
        {
            await LoadCategories();
        }
        else if (target == "account")
        {
            mfaSetup = null; mfaCode = ""; mfaMsg = ""; pwdMsg = "";
            myMfaEnabled = await Api.GetMyMfaStatus();
        }
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        // JS interop 必须等首次渲染后再调用（首屏 JS runtime 可能未就绪，读 localStorage 会返回 null）
        await I18n.InitAsync();
        var token = await JS.InvokeAsync<string>("localStorage.getItem", "durlinks_token");

        // 控制台必须已登录：无令牌直接回到静态登录页（不在 /console/ 渲染登录表单，避免闪屏）
        if (string.IsNullOrEmpty(token))
        {
            Nav.NavigateTo("/", forceLoad: true);
            return;
        }

        user = await JS.InvokeAsync<string>("localStorage.getItem", "durlinks_user") ?? "admin";
        role = await JS.InvokeAsync<string>("localStorage.getItem", "durlinks_role") ?? "Admin";
        loggedIn = true;

        try
        {
            await LoadAll();
        }
        catch
        {
            // 数据加载失败不阻断进入控制台（避免网络抖动把用户踢回登录页）
        }

        try { await ApplySectionAsync(view); }
        catch { /* 分功能加载失败不阻断进入控制台 */ }

        // 数据就绪后再切走骨架：从骨架直接过渡到完整界面，不会看到「0 条」闪变
        authChecked = true;
        StateHasChanged();
    }

