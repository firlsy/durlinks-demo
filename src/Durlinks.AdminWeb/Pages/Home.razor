    /// <summary>卡片上直接切换发布库在网页端/客户端的显示，无需进编辑表单。</summary>
    private async Task ToggleChannel(LibraryDto lib, bool web)
    {
        if (busyChannels.Contains(lib.Id)) return;
        busyChannels.Add(lib.Id);
        libMsg = null;
        try
        {
            var req = new LibrarySaveRequest
            {
                Name = lib.Name, Description = lib.Description,
                VisibleOnWeb = web ? !lib.VisibleOnWeb : lib.VisibleOnWeb,
                VisibleOnClient = web ? lib.VisibleOnClient : !lib.VisibleOnClient
            };
            var (ok, msg) = await Api.UpdateLibrary(lib.Id, req);
            if (!ok) { libMsg = msg; return; }
            if (web) lib.VisibleOnWeb = req.VisibleOnWeb; else lib.VisibleOnClient = req.VisibleOnClient;
        }
        finally { busyChannels.Remove(lib.Id); }
    }

