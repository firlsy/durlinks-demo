        var source = linkDrafts[index];
        linkDrafts.Insert(index + 1, new LinkDraft
        {
            Title = source.Title, Url = source.Url, GroupName = source.GroupName,
            Platform = source.Platform, LinkType = source.LinkType, ExtractCode = source.ExtractCode,
            ExpireAt = source.ExpireAt, Version = source.Version, Remark = source.Remark, TagsText = source.TagsText
        });
