    // stats 来自 JSON 反序列化，数字是 JsonElement，直接 Convert.ToInt32 会抛 InvalidCastException
    private int Num(string key)
    {
        if (!stats.TryGetValue(key, out var v)) return 0;
        if (v is int i) return i;
        if (v is long l) return (int)l;
        if (v is double d) return (int)d;
        if (v is System.Text.Json.JsonElement je)
        {
            if (je.ValueKind == System.Text.Json.JsonValueKind.Number) return je.GetInt32();
            if (int.TryParse(je.ToString(), out var n)) return n;
        }
        return int.TryParse(v?.ToString(), out var m) ? m : 0;
    }

    private int BarH(string key)
    {
        var t = Num("total");
        if (t == 0) return 0;
        var v = key switch
        {
            "manual" => t - Num("aiCount"),
            "ai" => Num("aiCount"),
            "netdisk" => Num("netdisk"),
            _ => Num("download")
        };
        return Math.Max(5, (int)((double)v / t * 100));
    }

