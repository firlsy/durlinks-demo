@page "/"
@page "/{Section}"
@using System.Globalization
@using Durlinks.Shared.DTOs
@using Durlinks.Shared.Enums
@using Durlinks.AdminWeb.Services
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@implements IDisposable
@inject AdminService Api
@inject I18nService I18n
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>durlinks-demo · @I18n["adminConsole"]</PageTitle>

@if (!authChecked)
{
    <!-- 会话检查中：复用 index.html 的骨架样式，视觉与启动页连续，避免闪现登录表单 -->
    <div class="boot-shell">
        <aside class="boot-side">
            <div class="boot-brand">
                <div class="boot-logo">DL</div>
                <div style="flex:1">
                    <div class="sk sk-line" style="width:62px;background:rgba(255,255,255,.16);margin-bottom:6px"></div>
                    <div class="sk sk-line" style="width:44px;background:rgba(255,255,255,.08);height:6px"></div>
                </div>
            </div>
            <nav class="boot-nav">
                <div class="boot-nav-item on"></div>
                <div class="boot-nav-item"></div>
                <div class="boot-nav-item"></div>
                <div class="boot-nav-item"></div>
                <div class="boot-nav-item"></div>
                <div class="boot-nav-item"></div>
            </nav>
        </aside>
        <main class="boot-main">
            <div class="boot-top"><div class="sk sk-title"></div></div>
            <div class="boot-body">
                <div class="boot-cards">
                    <div class="boot-card"></div><div class="boot-card"></div>
                    <div class="boot-card"></div><div class="boot-card"></div>
                </div>
                <div class="boot-panels">
                    <div class="boot-panel"></div><div class="boot-panel"></div>
                </div>
            </div>
        </main>
    </div>
}
else if (!loggedIn)
{
    <!-- ========== 登录页 ========== -->
    <div class="login-page">
        <div class="brand-wall">
            <div class="brand-top">
                <div class="brand-logo">DL</div>
                <div>
                    <div class="brand-name">durlinks-demo <span class="ver">v1.8.26</span></div>
                    <div class="brand-sub">@I18n["adminConsole"]</div>
                </div>
            </div>
            <div class="brand-center">
                <h1>链接，尽在掌握</h1>
                <p>集中管理、智能标注、即时检索<br/>你的私人链接仓库</p>
            </div>
            <div class="brand-bottom">
                <div class="feature"><span>◆</span> @(I18n.Lang=="zh"?"双通道导入 · AI 自动识别":"Dual-channel import · AI recognition")</div>
                <div class="feature"><span>◆</span> @(I18n.Lang=="zh"?"多用户协作 · MFA 安全加固":"Multi-user · MFA security")</div>
                <div class="feature"><span>◆</span> @(I18n.Lang=="zh"?"多端同步 · 网页与桌面一体":"Web & desktop in sync")</div>
                <div class="copyright">© 2026 durlinks-demo. All rights reserved.</div>
            </div>
            <div class="decor-circle"></div>
        </div>

        <div class="login-panel">
            <div class="lang-switch">
                <button class="@(I18n.Lang=="zh"?"on":"")" @onclick="SwitchZh">中文</button>
                <button class="@(I18n.Lang=="en"?"on":"")" @onclick="SwitchEn">EN</button>
            </div>
            <div class="login-card">
                <h2>@I18n["welcome"]</h2>
                <p class="subtitle">@I18n["loginSubtitle"]</p>

                <label>@I18n["username"]</label>
                <input class="field" @bind="user" @bind:after="CheckUserMfa" placeholder="admin" />

                <label>@I18n["password"]</label>
                <input class="field" type="password" @bind="pwd" @onkeyup="OnLoginKey" placeholder="••••••••" />

                <label>@I18n["captcha"]</label>
                <div class="captcha-row">
                    <input class="field" @bind="captchaCode" placeholder="@I18n["captchaPlaceholder"]" />
                    <button type="button" class="captcha-img" @onclick="RefreshCaptcha" title="@(I18n.Lang=="zh"?"点击刷新":"Click to refresh")">
                        <img src="@captchaSrc" alt="captcha" />
                    </button>
                </div>

                @if (mfaNeeded)
                {
                    <label class="optional">@I18n["totp"]</label>
                    <input class="field" @bind="totp" placeholder="6 digits" />
                }

                <button class="login-btn" @onclick="DoLogin" disabled="@busy">
                    @(busy ? I18n["loggingIn"] : I18n["login"])
                </button>

                @if (error != null) { <p class="error">@error</p> }
            </div>
        </div>
    </div>
}
else
{
    <!-- ========== 控制台 ========== -->
    <div class="console @(navFolded?"nav-folded":"")">
        <aside class="sidebar">
            <button class="side-fold" @onclick="()=>navFolded=!navFolded"
                    title="@(navFolded?(I18n.Lang=="zh"?"展开功能菜单":"Expand menu"):(I18n.Lang=="zh"?"收起功能菜单":"Collapse menu"))">@(navFolded?"»":"«")</button>
            <div class="side-brand">
                <div class="side-logo">DL</div>
                <div><div class="side-name">durlinks-demo <span class="ver">v1.8.26</span></div><div class="side-sub">@I18n["adminConsole"]</div></div>
            </div>
            <div class="side-label">@(I18n.Lang=="zh"?"主菜单":"MAIN MENU")</div>
            <nav>
                <button class="@(view=="dashboard"?"active":"")" @onclick="ViewDashboard"><span class="ico">▦</span>@I18n["dashboard"]</button>
                <button class="@(view=="publish"?"active":"")" @onclick="ViewPublish"><span class="ico">🗂</span>@I18n["publish"]</button>
                <button class="@(view=="categories"?"active":"")" @onclick="ViewCategories"><span class="ico">▤</span>@(I18n.Lang=="zh"?"分组管理":"Categories")</button>
                <button class="@(view=="users"?"active":"")" @onclick="ViewUsers"><span class="ico">☰</span>@I18n["users"]</button>
                <button class="@(view=="llm"?"active":"")" @onclick="ViewLlm"><span class="ico">✦</span>@I18n["llm"]</button>
                <button class="@(view=="account"?"active":"")" @onclick="ViewAccount"><span class="ico">⚙</span>@I18n["accountSettings"]</button>
            </nav>
            <div class="side-spacer"></div>
            <div class="side-bottom">
                <div class="side-label">@(I18n.Lang=="zh"?"偏好":"PREFERENCES")</div>
                <div class="lang-inline">
                    <span>@I18n["language"]</span>
                    <button class="@(I18n.Lang=="zh"?"on":"")" @onclick="SwitchZh">中文</button>
                    <button class="@(I18n.Lang=="en"?"on":"")" @onclick="SwitchEn">EN</button>
                </div>
            </div>
            <div class="side-user">
                <div class="avatar">A</div>
                <div><div class="u-name">@user</div><div class="u-role">@role · @I18n["superAdmin"]</div></div>
                <button class="logout-mini" @onclick="Logout" title="@I18n["logout"]">⇥</button>
            </div>
        </aside>

        <main class="main">
            <header class="topbar">
                <h1>@ViewTitle</h1>
                <div class="top-actions">
                    <button class="ghost" @onclick="LoadAll">⟳ @I18n["refresh"]</button>
                    <button class="ghost" @onclick="Logout">⇥ @I18n["logout"]</button>
                </div>
            </header>

            <div class="content">
                @if (view == "dashboard")
                {
                    <div class="stats-grid">
                        <div class="stat-card"><div class="stat-icon blue">🔗</div><div><div class="stat-label">@I18n["totalLinks"]</div><div class="stat-value">@Num("total")</div></div></div>
                        <div class="stat-card"><div class="stat-icon gray">◌</div><div><div class="stat-label">@I18n["hiddenLinks"]</div><div class="stat-value">@Num("hidden")</div></div></div>
                        <div class="stat-card"><div class="stat-icon purple">✦</div><div><div class="stat-label">@I18n["aiLinks"]</div><div class="stat-value">@Num("aiCount")</div></div></div>
                        <div class="stat-card"><div class="stat-icon orange">▦</div><div><div class="stat-label">@I18n["groups"]</div><div class="stat-value">@Num("groups")</div></div></div>
                    </div>

                    <div class="panel-row">
                        <div class="panel">
                            <div class="panel-title">@I18n["sourceStats"]</div>
                            <div class="bar-chart">
                                <div class="bar-item"><div class="bar" style="height:@(BarH("manual"))%"></div><span>@I18n["manual"]</span></div>
                                <div class="bar-item"><div class="bar purple" style="height:@(BarH("ai"))%"></div><span>@I18n["aiImported"]</span></div>
                                <div class="bar-item"><div class="bar teal" style="height:@(BarH("netdisk"))%"></div><span>@I18n["netdisk"]</span></div>
                                <div class="bar-item"><div class="bar orange" style="height:@(BarH("download"))%"></div><span>@I18n["download"]</span></div>
                            </div>
                        </div>
                        <div class="panel">
                            <div class="panel-title">@I18n["quickActions"]</div>
                            <div class="quick-actions">
                                <button @onclick="OpenImportModal">⇩ @I18n["goImport"]</button>
                                <button @onclick="ViewPublish">🗂 @I18n["goPublish"]</button>
                            </div>
                            <div class="mini-stats">
                                <div>@I18n["tags"]<b>@Num("tags")</b></div>
                                <div>@I18n["netdisk"]<b>@Num("netdisk")</b></div>
                                <div>@I18n["download"]<b>@Num("download")</b></div>
                            </div>
                        </div>
                    </div>
                }
                else if (view == "publish")
                {
                    <div class="publish-layout @(libFolded?"lib-folded":"")">
                    <aside class="panel lib-column @(libFolded?"folded":"")">
                        <button class="col-fold" @onclick="()=>libFolded=!libFolded"
                                title="@(libFolded?(I18n.Lang=="zh"?"展开发布库":"Expand libraries"):(I18n.Lang=="zh"?"收起发布库":"Collapse libraries"))">@(libFolded?"»":"«")</button>
                        @if (!libFolded)
                        {
                        <div class="lib-section">
                            <div class="lib-head">
                                <div>
                                    <h3>@I18n["publishLibraries"] <span class="badge manual" style="margin-left:6px">@libraries.Count</span></h3>
                                </div>
                            </div>

                            <div class="lib-grid lib-list">
                                @foreach (var lib in libraries)
                                {
                                    if (libFormOpen && libEditing && libEditingId == lib.Id)
                                    {
                                        @* 编辑：就地在原卡片位置展开表单，保存/取消后原地复原 *@
                                        <div class="lib-card editing">
                                            <div class="lib-card-head">
                                                <span class="lib-name">@(I18n.Lang=="zh"?"编辑发布库":"Edit library")</span>
                                                <span class="lib-actions" style="opacity:1">
                                                    <button @onclick="()=>libFormOpen=false" title="@I18n["cancel"]">×</button>
                                                </span>
                                            </div>
                                            <label>@I18n["libraryName"]</label>
                                            <input @bind="libName" placeholder="@(I18n.Lang=="zh"?"例如：软件下载 / 内部工具":"e.g. Software / Internal Tools")" />
                                            <label>@I18n["description"]</label>
                                            <input @bind="libDesc" />
                                            <div class="checks">
                                                <label><input type="checkbox" @bind="libWeb" /> @I18n["visibleOnWeb"]</label>
                                                <label><input type="checkbox" @bind="libClient" /> @I18n["visibleOnClient"]</label>
                                            </div>
                                            <div class="btn-row">
                                                <button class="primary" @onclick="SaveLibrary">@I18n["save"]</button>
                                                <button @onclick="()=>libFormOpen=false">@I18n["cancel"]</button>
                                            </div>
                                            @if (libMsg != null) { <p class="msg err">@libMsg</p> }
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="lib-card @(currentLibId==lib.Id?"on":"")" @onclick="()=>SelectLibrary(lib.Id)">
                                            <div class="lib-card-head">
                                                <span class="lib-name" title="@lib.Name">@lib.Name</span>
                                                <span class="lib-actions">
                                                    <button @onclick:stopPropagation="true" @onclick="()=>EditLibrary(lib)" title="@I18n["edit"]">✎</button>
                                                    <button class="danger" @onclick:stopPropagation="true" @onclick="()=>RemoveLibrary(lib)" title="@I18n["delete"]">×</button>
                                                </span>
                                            </div>
                                            <div class="lib-count"><b>@lib.LinkCount</b>@(I18n.Lang=="zh"?" 条链接":" links")</div>
                                            <div class="lib-channels">
                                                <button type="button" class="ch-pill @(lib.VisibleOnWeb?"on":"off")" @onclick:stopPropagation="true"
                                                        @onclick="()=>ToggleChannel(lib, true)"
                                                        title="@(I18n.Lang=="zh"?"点击切换是否在网页端显示":"Toggle web visibility")">@I18n["web"]</button>
                                                <button type="button" class="ch-pill @(lib.VisibleOnClient?"on":"off")" @onclick:stopPropagation="true"
                                                        @onclick="()=>ToggleChannel(lib, false)"
                                                        title="@(I18n.Lang=="zh"?"点击切换是否在客户端显示":"Toggle client visibility")">@I18n["client"]</button>
                                            </div>
                                        </div>
                                    }
                                }
                                <button class="lib-new" @onclick="StartNewLibrary">
                                    <span class="plus">+</span>
                                    <span>@I18n["newLibrary"]</span>
                                </button>
                            </div>
                            @if (!string.IsNullOrEmpty(publishMsg)) { <p class="msg">@publishMsg</p> }
                        </div>

                        @* 新建发布库：没有"原位置"可言，仍显示在列表下方 *@
                        @if (libFormOpen && !libEditing)
                        {
                            <div class="lib-form">
                                <label>@I18n["libraryName"]</label>
                                <input @bind="libName" placeholder="@(I18n.Lang=="zh"?"例如：软件下载 / 内部工具":"e.g. Software / Internal Tools")" />
                                <label>@I18n["description"]</label>
                                <input @bind="libDesc" />
                                <div class="checks">
                                    <label><input type="checkbox" @bind="libWeb" /> @I18n["visibleOnWeb"]</label>
                                    <label><input type="checkbox" @bind="libClient" /> @I18n["visibleOnClient"]</label>
                                </div>
                                <div class="btn-row">
                                    <button class="primary" @onclick="SaveLibrary">@I18n["save"]</button>
                                    <button @onclick="()=>libFormOpen=false">@I18n["cancel"]</button>
                                </div>
                                @if (libMsg != null) { <p class="msg err">@libMsg</p> }
                            </div>
                        }
                        }
                    </aside>

                    @* 链接新建/编辑：改为弹出窗口 *@
                    @if (linkFormOpen)
                    {
                        <div class="modal-mask">
                            <div class="modal @(linkEditing ? "" : "wide")" @onclick:stopPropagation="true">
                                <div class="modal-head">
                                    <span>@(linkEditing ? (I18n.Lang=="zh"?"编辑链接":"Edit link") : (I18n.Lang=="zh"?"新建链接":"New link"))</span>
                                    <button class="modal-x" @onclick="CloseLinkForm">×</button>
                                </div>
                                <div class="modal-body">
                                    <datalist id="cat-group-list">@foreach (var item in categoryGroups) { <option value="@item"></option> }</datalist>
                                    <datalist id="cat-platform-list">@foreach (var item in categoryPlatforms) { <option value="@item"></option> }</datalist>
                                    <datalist id="cat-tag-list">@foreach (var item in categoryTags) { <option value="@item"></option> }</datalist>
                                    @if (linkEditing)
                                    {
                                        <div class="form-2col">
                                            <div><label>@(I18n.Lang=="zh"?"链接形式":"Type")</label><select @bind="lfLinkType"><option value="">@(I18n.Lang=="zh"?"选择形式":"Select type")</option>@foreach (var item in categoryLinkTypes) { <option value="@item">@item</option> }</select></div>
                                            <div><label>@I18n["group"]（@(I18n.Lang=="zh"?"可多选":"multi")）</label><input @bind="lfGroup" list="cat-group-list" placeholder="@(I18n.Lang=="zh"?"多个用逗号分隔":"comma separated")" /></div>
                                        </div>
                                        <div class="form-2col">
                                            <div><label>@I18n["linkTitle"]</label><input @bind="lfTitle" /></div>
                                            <div><label>URL</label><input @bind="lfUrl" placeholder="https://" /></div>
                                        </div>
                                        @if (IsNetDisk(lfLinkType))
                                        {
                                            <div class="form-2col">
                                                <div><label>@(I18n.Lang=="zh"?"网盘提取码":"Extract code")</label><input @bind="lfExtractCode" /></div>
                                                <div><label>@(I18n.Lang=="zh"?"网盘过期时间":"Expire date")</label><input @bind="lfExpireAt" placeholder="2026-12-31" /></div>
                                            </div>
                                        }
                                        <div class="form-2col">
                                            <div><label>@I18n["platform"]（@(I18n.Lang=="zh"?"可多选":"multi")）</label><input @bind="lfPlatform" list="cat-platform-list" placeholder="@(I18n.Lang=="zh"?"多个用逗号分隔":"comma separated")" /></div>
                                            <div><label>@(I18n.Lang=="zh"?"版本":"Version")</label><input @bind="lfVersion" /></div>
                                        </div>
                                        <label>@I18n["tags"]（@(I18n.Lang=="zh"?"逗号分隔":"comma separated")）</label>
                                        <input @bind="lfSelectedTagsText" placeholder="@(I18n.Lang=="zh"?"多个标签用逗号分隔":"comma separated")" />
                                        <label>@I18n["remark"]</label>
                                        <textarea @bind="lfRemark" rows="3" placeholder="@(I18n.Lang=="zh"?"可换行":"multi-line allowed")"></textarea>
                                    }
                                    else
                                    {
                                        <div class="toolbar"><button @onclick="AddLinkDraft">+ @(I18n.Lang=="zh"?"新增一行":"Add row")</button><span class="hint">@(I18n.Lang=="zh"?"每行保存为一条链接；点击复制上一行后可逐项修改。":"Each row becomes a link. Duplicate a row then edit its values.")</span></div>
                                        <div class="link-draft-list">
                                            <div class="draft-row draft-head">
                                                <span></span>
                                                <span>@(I18n.Lang=="zh"?"链接形式":"Type")</span>
                                                <span>@I18n["linkTitle"]</span>
                                                <span>URL</span>
                                                <span>@I18n["group"]</span>
                                                <span>@I18n["platform"]</span>
                                                <span>@(I18n.Lang=="zh"?"标签":"Tags")</span>
                                                <span>@(I18n.Lang=="zh"?"版本":"Version")</span>
                                                <span>@I18n["remark"]</span>
                                                <span>@(I18n.Lang=="zh"?"操作":"Actions")</span>
                                            </div>
                                            @for (var i = 0; i < linkDrafts.Count; i++)
                                            {
                                                var index = i;
                                                var draft = linkDrafts[index];
                                                        <div class="link-draft">
                                                    <div class="draft-row">
                                                        <span class="draft-no">@(index + 1)</span>
                                                        <select @bind="draft.LinkType" class="draft-type" title="@(I18n.Lang=="zh"?"链接形式":"Type")"><option value="">@(I18n.Lang=="zh"?"形式":"Type")</option>@foreach (var item in categoryLinkTypes) { <option value="@item">@item</option> }</select>
                                                        <input @bind="draft.Title" placeholder="@(I18n.Lang=="zh"?"名称":"Title")" />
                                                        <input @bind="draft.Url" placeholder="URL" />
                                                        <input @bind="draft.GroupName" list="cat-group-list" placeholder="@(I18n.Lang=="zh"?"分组":"Group")" title="@(I18n.Lang=="zh"?"分组：可选可新建，多个用逗号分隔":"Group: select or create, comma separated")" />
                                                        <input @bind="draft.Platform" list="cat-platform-list" placeholder="@(I18n.Lang=="zh"?"平台":"Platform")" title="@(I18n.Lang=="zh"?"平台：可选可新建，多个用逗号分隔":"Platform: select or create, comma separated")" />
                                                        <input @bind="draft.TagsText" list="cat-tag-list" placeholder="@(I18n.Lang=="zh"?"标签":"Tags")" title="@(I18n.Lang=="zh"?"标签：可选可新建，多个用逗号分隔":"Tags: select or create, comma separated")" />
                                                        <input @bind="draft.Version" placeholder="@(I18n.Lang=="zh"?"版本":"Version")" />
                                                        <input @bind="draft.Remark" placeholder="@(I18n.Lang=="zh"?"备注":"Remark")" title="@(I18n.Lang=="zh"?"备注":"Remark")" />
                                                        <span class="draft-ops"><button @onclick="()=>DuplicateLinkDraft(index)" title="@(I18n.Lang=="zh"?"复制这一行":"Duplicate row")">克隆</button><button class="danger" @onclick="()=>RemoveLinkDraft(index)" disabled="@(linkDrafts.Count == 1)" title="@I18n["delete"]">×</button></span>
                                                    </div>
                                                    @if (IsNetDisk(draft.LinkType))
                                                    {
                                                        <div class="draft-row draft-netdisk">
                                                            <span class="draft-spacer"></span>
                                                            <span class="draft-net-label">@(I18n.Lang=="zh"?"网盘提取码":"Extract code")</span>
                                                            <input @bind="draft.ExtractCode" placeholder="@(I18n.Lang=="zh"?"提取码":"Code")" />
                                                            <span class="draft-net-label">@(I18n.Lang=="zh"?"过期时间":"Expire date")</span>
                                                            <input @bind="draft.ExpireAt" placeholder="2026-12-31" />
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }
                                    @if (linkFormMsg != null) { <p class="msg err">@linkFormMsg</p> }
                                </div>
                                <div class="modal-foot">
                                    <button @onclick="CloseLinkForm">@I18n["cancel"]</button>
                                    <button class="primary" @onclick="SaveLinkForm">@I18n["save"]</button>
                                </div>
                            </div>
                        </div>
                    }

                    <div class="links-column">
                    <div class="panel">
                        <div class="panel-title">
                            @(currentLibName ?? I18n["links"])
                            <span class="badge manual" style="margin-left:8px">@total</span>
                        </div>

                        <div class="toolbar">
                            <input placeholder="@(I18n.Lang=="zh"?"搜索名称/链接…":"Search title/url…")" @bind="q" @bind:event="oninput" @bind:after="ReloadFromFirstPage" />
                            <select @bind="srcFilter" @bind:after="ReloadFromFirstPage">
                                <option value="">@I18n["allSources"]</option>
                                <option value="0">@I18n["manual"]</option>
                                <option value="1">@I18n["aiImported"]</option>
                            </select>
                            <button class="primary" @onclick="StartNewLink">+ @I18n["newLink"]</button>
                            <button @onclick="OpenImportModal">⇩ @I18n["import"]</button>
                            <span class="sel-count">@(I18n.Lang=="zh"?"已选":"Selected") @selected.Count</span>
                            <button @onclick="()=>BatchHide(true)">@(I18n.Lang=="zh"?"隐藏":"Hide")</button>
                            <button @onclick="()=>BatchHide(false)">@(I18n.Lang=="zh"?"显示":"Show")</button>
                            <button class="danger" @onclick="BatchDel">@(I18n.Lang=="zh"?"删除":"Delete")</button>
                            <button @onclick="OpenDedupe" disabled="@dedupeBusy" title="@(I18n.Lang=="zh"?"清理当前库内 URL 重复的链接":"Remove duplicate URLs in current library")">@(I18n.Lang=="zh"?"去重":"Dedupe")</button>
                            <button @onclick="ExportLinks" disabled="@exporting">@(exporting?(I18n.Lang=="zh"?"导出中…":"Exporting…"):(I18n.Lang=="zh"?"导出":"Export"))</button>
                            @if (!string.IsNullOrEmpty(exportMsg))
                            {
                                <span class="msg err">@exportMsg</span>
                            }
                        </div>

                        @* 批量 AI 补料（表格上方） *@
                        <div class="toolbar enrich-bar">
                            <span class="sel-count">✦ @(I18n.Lang=="zh"?"批量 AI 补料（为无摘要/标签的链接生成标签与摘要）":"Batch AI Enrich (generate tags & summaries for links lacking them)")</span>
                            <label style="font-size:12px;color:#64748b">@(I18n.Lang=="zh"?"范围":"Scope")
                                <select @bind="enrichMode" style="padding:3px 6px">
                                    <option value="missing">@(I18n.Lang=="zh"?"仅未补料":"Missing only")</option>
                                    <option value="all">@(I18n.Lang=="zh"?"全部":"All")</option>
                                </select>
                            </label>
                            <label style="font-size:12px;color:#64748b">@(I18n.Lang=="zh"?"条数":"Limit")
                                <input type="number" @bind="enrichLimit" min="1" max="100000" style="width:92px;padding:3px 6px" />
                            </label>
                            <button @onclick="StartBatch" disabled="@(enrichStatus?.Running==true)">@(I18n.Lang=="zh"?"开始补料":"Start")</button>
                            @if (enrichStatus?.Running == true)
                            {
                                <button @onclick="CancelBatch">@(I18n.Lang=="zh"?"取消":"Cancel")</button>
                            }
                            @if (enrichStatus != null && (enrichStatus.Running || enrichStatus.Processed > 0 || enrichStatus.Total > 0))
                            {
                                <span class="enrich-progress">@enrichStatus.Processed/@enrichStatus.Total
                                    ✓@enrichStatus.Succeeded ✗@enrichStatus.Failed ⊘@enrichStatus.Skipped
                                    @if (!string.IsNullOrEmpty(enrichStatus.Message))
                                    {
                                        <span class="msg @(enrichStatus.Failed > 0 || (!enrichStatus.Running && enrichStatus.Total == 0) ? "err" : "")">@enrichStatus.Message</span>
                                    }
                                </span>
                            }
                        </div>

                        @* 移动/复制栏（每页条数固定靠右显示，单库时也保留） *@
                        <div class="toolbar move-bar">
                            @if (libraries.Count > 1)
                            {
                                <span class="sel-count">@I18n["moveTo"]</span>
                                <select @bind="targetLibId">
                                    <option value="0">@(I18n.Lang=="zh"?"选择目标发布库…":"Select target library…")</option>
                                    @foreach (var lib in libraries.Where(x => x.Id != currentLibId))
                                    {
                                        <option value="@lib.Id">@lib.Name</option>
                                    }
                                </select>
                                <button @onclick="MoveSelected" disabled="@(selected.Count==0 || targetLibId==0)">@I18n["move"]</button>
                                <button @onclick="CopySelected" disabled="@(selected.Count==0 || targetLibId==0)">@I18n["copyLinks"]</button>
                                @if (transferMsg != null) { <span class="msg @(transferErr?"err":"")" style="margin:0">@transferMsg</span> }
                            }
                            <label class="page-size">
                                <span>@(I18n.Lang=="zh"?"每页":"Per page")</span>
                                <select @bind="pageSize" @bind:after="OnPageSizeChanged" title="@(I18n.Lang=="zh"?"当前页显示条数":"Rows per page")">
                                    @foreach (var n in PageSizeOptions)
                                    {
                                        <option value="@n">@n</option>
                                    }
                                </select>
                                <span>@(I18n.Lang=="zh"?"条":"rows")</span>
                            </label>
                        </div>
                        <table class="grid links-grid">
                            <colgroup>
                                <col style="width:34px" />
                                <col style="width:16%" />
                                <col style="width:20%" />
                                <col style="width:17%" />
                                <col style="width:8%" />
                                <col style="width:8%" />
                                <col style="width:7%" />
                                <col style="width:7%" />
                                <col style="width:6%" />
                                <col style="width:134px" />
                            </colgroup>
                            <thead><tr><th title="@(I18n.Lang=="zh"?"全选/取消全选当前列表":"Select / deselect all in current list")"><input type="checkbox" checked="@(links.Count > 0 && links.All(l => selected.Contains(l.Id)))" @onchange="e => ToggleAllLinks(e.Value is bool b && b)" /></th><th>@(I18n.Lang=="zh"?"名称":"Title")</th><th>@(I18n.Lang=="zh"?"链接":"URL")</th><th>@(I18n.Lang=="zh"?"摘要":"Summary")</th><th>@(I18n.Lang=="zh"?"形式":"Type")</th><th>@(I18n.Lang=="zh"?"分组":"Group")</th><th>@(I18n.Lang=="zh"?"平台":"Platform")</th><th>@(I18n.Lang=="zh"?"来源":"Source")</th><th>@(I18n.Lang=="zh"?"状态":"Status")</th><th>@(I18n.Lang=="zh"?"操作":"Actions")</th></tr></thead>
                            <tbody>
                                @foreach (var l in links)
                                {
                                    <tr>
                                        <td><input type="checkbox" checked="@selected.Contains(l.Id)" @onchange="()=>Toggle(l.Id)" /></td>
                                        <td><a href="@l.Url" target="_blank" rel="noopener noreferrer" title="@l.Title">@l.Title</a></td>
                                        <td><a class="url-cell" href="@l.Url" target="_blank" rel="noopener noreferrer" title="@l.Url">@l.Url</a></td>
                                        <td><span class="summary-cell" title="@l.Summary">@l.Summary</span></td>
                                        <td>@l.LinkType</td>
                                        <td><span class="multi-cell" title="@l.GroupName">@l.GroupName</span></td>
                                        <td><span class="multi-cell" title="@l.Platform">@l.Platform</span></td>
                                        <td><span class="badge @(l.ImportSource==ImportSource.AiImported?"ai":"manual")">@(l.ImportSource==ImportSource.AiImported ? "AI" : (I18n.Lang=="zh"?"人工":"Manual"))</span></td>
                                        <td>@(l.IsHidden ? (I18n.Lang=="zh"?"已隐藏":"Hidden") : (I18n.Lang=="zh"?"可见":"Visible"))</td>
                                        <td class="row-actions">
                                            <button @onclick="()=>EditLink(l)">@I18n["edit"]</button>
                                            <button @onclick="()=>Hide(l)">@(l.IsHidden?(I18n.Lang=="zh"?"显示":"Show"):(I18n.Lang=="zh"?"隐藏":"Hide"))</button>
                                            <button @onclick="()=>Enrich(l)">AI</button>
                                            <button class="danger" @onclick="()=>Del(l)">×</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        <div class="pager">
                            <span class="total-line" style="margin:0">
                                @(I18n.Lang=="zh"?"共":"Total") @total @(I18n.Lang=="zh"?"条":"items")
                                · @(I18n.Lang=="zh"?"第":"Page") @(page) / @(pageCount) @(I18n.Lang=="zh"?"页":"")
                                · @(I18n.Lang=="zh"?"每页":"Per page") @pageSize @(I18n.Lang=="zh"?"条":"rows")
                            </span>
                            <span class="pager-btns">
                                <button @onclick="()=>GoPage(1)" disabled="@(page == 1)" title="@(I18n.Lang=="zh"?"首页":"First")">«</button>
                                <button @onclick="()=>GoPage(page-1)" disabled="@(page == 1)">@(I18n.Lang=="zh"?"上一页":"Prev")</button>
                                <select @bind="page" @bind:after="OnPageJump">
                                    @for (var p = 1; p <= pageCount; p++)
                                    {
                                        <option value="@p">@p</option>
                                    }
                                </select>
                                <button @onclick="()=>GoPage(page+1)" disabled="@(page>=pageCount)">@(I18n.Lang=="zh"?"下一页":"Next")</button>
                                <button @onclick="()=>GoPage(pageCount)" disabled="@(page>=pageCount)" title="@(I18n.Lang=="zh"?"末页":"Last")">»</button>
                            </span>
                        </div>
                    </div>
                    </div>
                    </div>

                    @* 导入（已并入发布库：导入到当前选中的库） *@
                    @if (importOpen)
                    {
                        <div class="modal-mask">
                            <div class="modal" @onclick:stopPropagation="true">
                                <div class="modal-head">
                                    <span>@(I18n.Lang=="zh"?"导入链接":"Import Links") · @(currentLibName ?? "-")</span>
                                    <button class="modal-x" @onclick="CloseImportModal">×</button>
                                </div>
                                <div class="modal-body">
                                    <div class="modal-tabs">
                                        <button class="@(importTab=="ai"?"on":"")" @onclick="SetImportTabAi">@(I18n.Lang=="zh"?"AI 接入":"AI import")</button>
                                        <button class="@(importTab=="excel"?"on":"")" @onclick="SetImportTabExcel">Excel @(I18n.Lang=="zh"?"导入":"import")</button>
                                    </div>
                                    <p class="hint">@(I18n.Lang=="zh"
                                        ? $"导入到当前发布库「{currentLibName}」；导入完成后右侧列表会自动刷新。"
                                        : $"Links will be imported into \"{currentLibName}\"; the list refreshes automatically.")</p>

                                    @if (importTab == "ai")
                                    {
                                        <label>@(I18n.Lang=="zh"?"粘贴链接（每行一条，可附说明）":"Paste links (one per line, optional note)")</label>
                                        <textarea rows="8" @bind="pasteText" placeholder="https://example.com/app.exe（每行一条，可附提取码等说明）"></textarea>
                                        <div class="btn-row">
                                            <button @onclick="DoParseLinks" disabled="@parseBusy">
                                                @(parseBusy ? (I18n.Lang=="zh"?"识别中…":"Recognizing…") : (I18n.Lang=="zh"?"识别预览":"Preview"))
                                            </button>
                                            <button class="primary" @onclick="DoImportLinks" disabled="@importBusy">
                                                @(importBusy ? (I18n.Lang=="zh"?"导入中…":"Importing…") : (I18n.Lang=="zh"?"确认导入":"Confirm import"))
                                            </button>
                                        </div>
                                        @if (parseJson != null) { <pre class="json">@parseJson</pre> }
                                    }
                                    else
                                    {
                                        <div class="import-excel">
                                            <button class="link-btn" @onclick="DownloadTemplate">↓ @(I18n.Lang=="zh"?"下载导入模板":"Download template")</button>
                                            <InputFile OnChange="OnExcelFile" />
                                            @if (excelFile != null)
                                            {
                                                <p class="hint">@(I18n.Lang=="zh"?"已选择：":"Selected: ")@excelFile.Name（@(Math.Round(excelFile.Size / 1024.0, 1)) KB）</p>
                                            }
                                            <button class="primary" @onclick="DoImportExcel" disabled="@(importBusy || importStatus?.Running==true)">
                                                @(importBusy ? (I18n.Lang=="zh"?"上传中…":"Uploading…") : (importStatus?.Running==true ? (I18n.Lang=="zh"?"导入中…":"Importing…") : (I18n.Lang=="zh"?"上传并导入":"Upload & import")))
                                            </button>
                                            <p class="hint" style="margin:0">@(I18n.Lang=="zh" ? "大文件在后台导入，可关闭弹窗，进度不会丢。" : "Large files import in background; you can close this dialog.")</p>
                                        </div>

                                        @if (importStatus is { Running: true })
                                        {
                                            <div class="import-progress">
                                                <div class="ip-line">
                                                    <span class="ip-dot"></span>
                                                    <b>@(I18n.Lang=="zh"?"导入进行中":"Importing")</b>
                                                    <span>@(I18n.Lang=="zh"?"已扫描":"Scanned") @importStatus.Processed @(I18n.Lang=="zh"?"行":"rows") · @(I18n.Lang=="zh"?"已入库":"imported") @importStatus.Imported @(I18n.Lang=="zh"?"条":"links")</span>
                                                </div>
                                                <div class="ip-bar"><span></span></div>
                                                <button @onclick="CancelExcelImport">@(I18n.Lang=="zh"?"取消导入":"Cancel")</button>
                                            </div>
                                        }
                                    }

                                    @if (importMsg != null)
                                    {
                                        <p class="msg @(importErr?"err":"")">@importMsg</p>
                                    }
                                </div>
                                <div class="modal-foot">
                                    <button @onclick="CloseImportModal">@(I18n.Lang=="zh"?"关闭":"Close")</button>
                                </div>
                            </div>
                        </div>
                    }

                    @* 删除发布库：密码二次确认 *@
                    @if (libDelOpen && libDelTarget != null)
                    {
                        <div class="modal-mask">
                            <div class="modal modal-sm" @onclick:stopPropagation="true">
                                <div class="modal-head">
                                    <span>@(I18n.Lang=="zh"?"删除发布库":"Delete library")</span>
                                    <button class="modal-x" @onclick="CloseLibDelete">×</button>
                                </div>
                                <div class="modal-body">
                                    <div class="warn-box">
                                        @(I18n.Lang=="zh"
                                            ? $"将删除发布库「{libDelTarget.Name}」及其下 {libDelTarget.LinkCount} 条链接（软删除，界面上不可恢复）。"
                                            : $"Library \"{libDelTarget.Name}\" and its {libDelTarget.LinkCount} links will be removed (soft delete, not recoverable in UI).")
                                    </div>
                                    <label>@(I18n.Lang=="zh"?"输入当前账号密码以确认":"Enter your account password to confirm")</label>
                                    <input type="password" @bind="libDelPwd" @onkeydown="OnLibDelKey" placeholder="••••••••" autocomplete="current-password" />
                                    @if (libDelMsg != null) { <p class="msg err">@libDelMsg</p> }
                                </div>
                                <div class="modal-foot">
                                    <button @onclick="CloseLibDelete">@I18n["cancel"]</button>
                                    <button class="danger-solid" @onclick="ConfirmDeleteLibrary" disabled="@libDelBusy">
                                        @(libDelBusy ? (I18n.Lang=="zh"?"删除中…":"Deleting…") : (I18n.Lang=="zh"?"确认删除":"Delete"))
                                    </button>
                                </div>
                            </div>
                        </div>
                    }

                    @if (dedupeOpen)
                    {
                        <div class="modal-mask">
                            <div class="modal modal-sm" @onclick:stopPropagation="true">
                                <div class="modal-head">
                                    <span>@(I18n.Lang=="zh"?"链接去重":"Deduplicate links")</span>
                                    <button class="modal-x" @onclick="CloseDedupe">×</button>
                                </div>
                                <div class="modal-body">
                                    <div class="warn-box">
                                        @(I18n.Lang=="zh"
                                            ? "按链接地址去重（忽略大小写、首尾空格和末尾斜杠），每组保留最早导入的一条，其余软删除。"
                                            : "Deduplicate by URL (case/space/trailing slash insensitive). Keeps the oldest in each group and soft-deletes the rest.")
                                    </div>
                                    <label style="display:flex;align-items:center;gap:8px">
                                        <input type="checkbox" @bind="dedupeAll" /> @(I18n.Lang=="zh"?"跨全部发布库（默认仅当前库）":"All libraries (default: current only)")
                                    </label>
                                    @if (dedupeResult != null)
                                    {
                                        <div class="dedupe-summary">
                                            @(I18n.Lang=="zh"
                                                ? $"扫描 {dedupeResult.Scanned} 条，{dedupeResult.Groups} 组重复，可清理 {dedupeResult.Duplicates} 条"
                                                : $"Scanned {dedupeResult.Scanned}, {dedupeResult.Groups} duplicate groups, {dedupeResult.Duplicates} removable")
                                            @if (dedupeResult.Samples.Count > 0)
                                            {
                                                <ul>
                                                    @foreach (var s in dedupeResult.Samples)
                                                    {
                                                        <li title="@s.Url">@s.Url <b>×@s.Count</b></li>
                                                    }
                                                </ul>
                                            }
                                        </div>
                                    }
                                    @if (dedupeMsg != null) { <p class="msg err">@dedupeMsg</p> }
                                </div>
                                <div class="modal-foot">
                                    <button @onclick="CloseDedupe">@I18n["cancel"]</button>
                                    <button @onclick="PreviewDedupe" disabled="@dedupeBusy">@(I18n.Lang=="zh"?"预览重复":"Preview")</button>
                                    <button class="danger-solid" @onclick="ConfirmDedupe" disabled="@(dedupeBusy || dedupeResult==null || dedupeResult.Duplicates==0)">
                                        @(dedupeBusy ? (I18n.Lang=="zh"?"处理中…":"Working…") : (I18n.Lang=="zh"?"确认去重":"Remove duplicates"))
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                }
                else if (view == "categories")
                {
                    var selKind = selCategoryKind;
                    var selTitle = CategorySections.First(x => x.kind == selKind).title;
                    var values = GetCategoryValues(selKind);
                    var term = categorySearch.TryGetValue(selKind, out var t) ? t?.Trim() ?? "" : "";
                    var shown = string.IsNullOrEmpty(term)
                        ? values.Take(categoryExpanded.Contains(selKind) ? values.Count : 200).ToList()
                        : values.Where(x => x.Contains(term, StringComparison.OrdinalIgnoreCase)).Take(500).ToList();
                    <div class="publish-layout cat-layout @(catFolded?"lib-folded":"")">
                        <aside class="panel lib-column @(catFolded?"folded":"")">
                            <button class="col-fold" @onclick="()=>catFolded=!catFolded"
                                    title="@(catFolded?(I18n.Lang=="zh"?"展开分类":"Expand categories"):(I18n.Lang=="zh"?"收起分类":"Collapse categories"))">@(catFolded?"»":"«")</button>
                            @if (!catFolded)
                            {
                                <div class="lib-section">
                                    <div class="lib-head">
                                        <h3>@(I18n.Lang=="zh"?"分类":"Categories") <span class="badge manual" style="margin-left:6px">@CategorySections.Count()</span></h3>
                                    </div>
                                    <div class="lib-grid lib-list">
                                        @foreach (var section in CategorySections)
                                        {
                                            var kind = section.kind;
                                            var count = GetCategoryValues(kind).Count;
                                            <div class="lib-card @(selKind==kind?"on":"")" @onclick="()=>SelectCategory(kind)">
                                                <div class="lib-card-head"><span class="lib-name" title="@section.title">@section.title</span></div>
                                                <div class="lib-count"><b>@count</b>@(I18n.Lang=="zh"?" 项":" items")</div>
                                                <div class="lib-channels"><span class="ch-pill @(CategorySelection(kind).Count>0?"on":"")">@(I18n.Lang=="zh" ? $"已选 {CategorySelection(kind).Count}" : $"{CategorySelection(kind).Count} selected")</span></div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </aside>

                        <div class="links-column">
                            <div class="panel">
                                <div class="panel-title">@selTitle <span class="badge manual" style="margin-left:6px">@values.Count</span></div>
                                <p class="hint">@(I18n.Lang=="zh"?"这里维护链接录入和筛选使用的选项。重命名会同步更新已有链接；仍被链接使用的选项不能删除。":"Manage options used by link forms and filters. Renaming updates existing links; options in use cannot be deleted.")</p>
                                <div class="toolbar">
                                    <input @bind="categoryNewName[selKind]" placeholder="@(I18n.Lang=="zh"?"输入新名称":"New name")" />
                                    <button class="primary" @onclick="()=>AddCategory(selKind)">+ @(I18n.Lang=="zh"?"新建":"New")</button>
                                    <input @bind="categorySearch[selKind]" @bind:event="oninput" placeholder="@(I18n.Lang=="zh"?"搜索选项…":"Search options…")" />
                                    @if (CategorySelectedCount > 0)
                                    {
                                        <span class="hint">@(I18n.Lang=="zh" ? $"已勾选 {CategorySelectedCount} 项（跨分类累计）" : $"{CategorySelectedCount} selected")</span>
                                        <button class="danger-solid" @onclick="DeleteSelectedCategoriesConfirm">@(I18n.Lang=="zh"?"批量删除":"Delete selected")</button>
                                        <button @onclick="ClearCategorySelection">@(I18n.Lang=="zh"?"清空选择":"Clear")</button>
                                    }
                                </div>
                                @if (!string.IsNullOrWhiteSpace(categoryMsg)) { <p class="msg @(categoryErr?"err":"")">@categoryMsg</p> }
                                <div class="cat-table-head">
                                    <input type="checkbox" checked="@(shown.Count > 0 && shown.All(x => IsCategorySelected(selKind, x)))" @onchange="e => ToggleVisibleCategorySelection(selKind, shown, e.Value is bool b && b)" />
                                    <span>@(I18n.Lang=="zh"?"名称":"Name")</span>
                                    <span>@(I18n.Lang=="zh"?"操作":"Actions")</span>
                                </div>
                                <div class="category-items category-table">
                                    @foreach (var item in shown)
                                    {
                                        <div class="category-item @(IsCategorySelected(selKind,item) ? "selected" : "")">
                                            <input type="checkbox" checked="@IsCategorySelected(selKind,item)" @onchange="e => ToggleCategorySelection(selKind,item, e.Value is bool b && b)" />
                                            <span>@item</span>
                                            <div class="row-actions">
                                                <button @onclick="()=>RenameCategoryPrompt(selKind,item)">@(I18n.Lang=="zh"?"重命名":"Rename")</button>
                                                <button class="danger" @onclick="()=>DeleteCategoryConfirm(selKind,item)">×</button>
                                            </div>
                                        </div>
                                    }
                                    @if (values.Count == 0) { <p class="hint">@(I18n.Lang=="zh"?"暂无选项":"No options")</p> }
                                    @if (string.IsNullOrEmpty(term) && values.Count > 200 && !categoryExpanded.Contains(selKind))
                                    {
                                        <button class="cat-more" @onclick="()=>categoryExpanded.Add(selKind)">@(I18n.Lang=="zh"?$"还有 {values.Count - 200} 项，点击展开":"+ {values.Count - 200} more")</button>
                                    }
                                </div>
                                <div class="hint" style="margin-top:10px">@(I18n.Lang=="zh" ? $"显示 {shown.Count} / {values.Count} 项" : $"Showing {shown.Count} / {values.Count}")</div>
                            </div>
                        </div>
                    </div>
                }
                else if (view == "users")
                {
                    <div class="panel">
                        <div class="panel-title">@I18n["users"]</div>
                        @if (role != "SuperAdmin")
                        {
                            <p class="hint">@(I18n.Lang=="zh"?"仅超级管理员可管理用户。":"Only super admin can manage users.")</p>
                        }
                        else
                        {
                            <div class="toolbar">
                                <input placeholder="@(I18n.Lang=="zh"?"新用户名":"New username")" @bind="newUser" />
                                <input placeholder="@(I18n.Lang=="zh"?"密码":"Password")" @bind="newPwd" />
                                <button class="primary" @onclick="DoCreateUser">@(I18n.Lang=="zh"?"创建管理员":"Create Admin")</button>
                            </div>
                            <table class="grid">
                                <thead><tr><th>@(I18n.Lang=="zh"?"用户名":"Username")</th><th>@(I18n.Lang=="zh"?"角色":"Role")</th><th>MFA</th><th>@(I18n.Lang=="zh"?"创建时间":"Created")</th></tr></thead>
                                <tbody>
                                    @foreach (var u in users)
                                    {
                                        <tr><td>@u.Username</td><td>@u.Role</td><td>@(u.MfaEnabled?"✓":"—")</td><td>@u.CreatedAt.ToString("yyyy-MM-dd")</td></tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </div>
                }
                else if (view == "llm")
                {
                    <div class="panel">
                        <div class="panel-title" style="display:flex;align-items:center;justify-content:space-between;gap:12px">
                            <span>@(I18n.Lang=="zh"?"模型服务":"Model Providers") <span class="badge manual" style="margin-left:6px">@llmConfigs.Count</span></span>
                            <button class="primary" @onclick="OpenProviderForm">+ @(I18n.Lang=="zh"?"添加自定义提供商":"Add Provider")</button>
                        </div>
                        <p class="hint">@(I18n.Lang=="zh"
                            ? "可添加多个 API 站点，每个站点可挂多个模型（可自定义任意模型名）；点卡片上的模型名可切换当前使用项。标记为默认的站点用于链接识别与批量补料。"
                            : "Add multiple API endpoints, each with multiple models (any custom name). Click a model on the card to switch the active one. The default provider is used for recognition and batch enrichment.")</p>

                        @if (llmConfigs.Count == 0)
                        {
                            <p class="hint" style="padding:18px 0">@(I18n.Lang=="zh"?"还没有配置，点击右上角添加。":"No providers yet. Add one at the top right.")</p>
                        }
                        else
                        {
                            <div class="provider-list">
                                @foreach (var c in llmConfigs)
                                {
                                    <div class="provider-card @(c.IsDefault?"on":"")">
                                        <div class="provider-main">
                                            <div class="provider-name">
                                                @c.Name
                                                <span class="proto-pill">@(string.IsNullOrEmpty(c.Protocol)?"openai":c.Protocol)</span>
                                                @if (c.IsDefault) { <span class="badge ai">@(I18n.Lang=="zh"?"默认":"Default")</span> }
                                                @if (!c.IsConfigured) { <span class="badge manual">@(I18n.Lang=="zh"?"未完成":"Incomplete")</span> }
                                            </div>
                                            <div class="provider-meta">@c.ApiEndpoint</div>
                                            <div class="provider-models">
                                                @foreach (var m in ModelList(c))
                                                {
                                                    <button class="model-pill @(m==c.Model?"on":"")"
                                                            title="@(I18n.Lang=="zh"?"设为当前模型":"Use this model")"
                                                            @onclick="()=>SwitchModel(c,m)">@m</button>
                                                }
                                            </div>
                                        </div>
                                        <div class="provider-actions">
                                            <button @onclick="()=>TestProvider(c)" disabled="@llmTesting">@(I18n.Lang=="zh"?"检测":"Test")</button>
                                            <button @onclick="()=>EditProvider(c)">@I18n["edit"]</button>
                                            @if (!c.IsDefault) { <button @onclick="()=>MakeDefault(c)">@(I18n.Lang=="zh"?"设为默认":"Set default")</button> }
                                            <button class="danger" @onclick="()=>DeleteProvider(c)">×</button>
                                        </div>
                                    </div>
                                }
                            </div>
                        }

                        @if (llmMsg != null) { <p class="msg">@llmMsg</p> }
                        @if (!string.IsNullOrWhiteSpace(llmTestMsg))
                        {
                            <p class="msg @(llmTestOk?"":"err")">
                                @(llmTestOk ? "✓ " : "✗ ")@llmTestMsg
                                @(llmTestOk && llmTestMs > 0 ? $" · {llmTestMs} ms" : "")
                            </p>
                        }
                    </div>

                    @if (providerFormOpen)
                    {
                        <div class="modal-mask">
                            <div class="modal" @onclick:stopPropagation="true">
                                <div class="modal-head">
                                    <span>@(pfId > 0 ? (I18n.Lang=="zh"?"编辑提供商":"Edit Provider") : (I18n.Lang=="zh"?"添加自定义提供商":"Add Provider"))</span>
                                    <button class="modal-x" @onclick="CloseProviderForm">×</button>
                                </div>
                                <div class="modal-body">
                                    <label>@(I18n.Lang=="zh"?"提供商名称":"Provider name")</label>
                                    <input @bind="pfName" placeholder="@(I18n.Lang=="zh"?"例如 OpenAI / 中转站 A":"e.g. OpenAI")" />

                                    <label>API @(I18n.Lang=="zh"?"密钥":"Key")</label>
                                    <input type="password" @bind="pfKey" placeholder="@(pfHasKey ? pfKeyMask : "sk-...")" />
                                    @if (pfHasKey) { <p class="hint">@(I18n.Lang=="zh"?"已保存密钥，留空表示不修改。":"Key saved. Leave blank to keep it.")</p> }

                                    <div class="form-section">@(I18n.Lang=="zh"?"端点设置":"Endpoint")</div>
                                    <div class="form-2col">
                                        <div>
                                            <label>@(I18n.Lang=="zh"?"协议":"Protocol")</label>
                                            <select @bind="pfProtocol">
                                                <option value="openai">OpenAI @(I18n.Lang=="zh"?"兼容（Chat Completions）":"compatible (Chat Completions)")</option>
                                                <option value="openai-responses">OpenAI Responses</option>
                                                <option value="anthropic">Anthropic Messages</option>
                                                <option value="gemini">Gemini</option>
                                            </select>
                                        </div>
                                        <div>
                                            <label>Base URL</label>
                                            <input @bind="pfEndpoint" placeholder="https://api.openai.com/v1" />
                                        </div>
                                    </div>
                                    <p class="hint">@(I18n.Lang=="zh"?"填到版本路径即可，保存后自动拼接请求路径。":"Base URL including version path; request path is appended automatically.")</p>

                                    <div class="form-section model-section-head">
                                        <span>@(I18n.Lang=="zh"?"模型列表（可添加多个，点选当前使用）":"Models (add several, click to activate)")</span>
                                        <button type="button" class="fetch-models" @onclick="FetchProviderModels" disabled="@pfFetchingModels">
                                            @(pfFetchingModels
                                                ? (I18n.Lang=="zh"?"获取中…":"Fetching…")
                                                : (I18n.Lang=="zh"?"获取可用模型":"Fetch available models"))
                                        </button>
                                    </div>
                                    <div class="model-editor">
                                        @foreach (var m in pfModels)
                                        {
                                            <span class="model-chip @(m==pfModel?"on":"")" @onclick="()=>SetPfActive(m)">
                                                <span class="chip-name">@m</span>
                                                @if (m == pfModel) { <span class="chip-tag">@(I18n.Lang=="zh"?"当前":"active")</span> }
                                                <button type="button" class="chip-x" title="@I18n["delete"]"
                                                        @onclick:stopPropagation="true" @onclick="()=>RemovePfModel(m)">×</button>
                                            </span>
                                        }
                                        @if (pfModels.Count == 0)
                                        {
                                            <span class="hint" style="margin:0">@(I18n.Lang=="zh"?"还没有模型，在下方输入后点「添加模型」":"No models yet — add one below")</span>
                                        }
                                    </div>
                                    <div class="model-add">
                                        <input @bind="pfNewModel" @onkeydown="OnPfModelKey" list="llm-model-presets"
                                               placeholder="@(I18n.Lang=="zh"?"输入或选择模型名，例如 gpt-4o-mini":"Model name, e.g. gpt-4o-mini")" />
                                        <button type="button" @onclick="AddPfModel">+ @(I18n.Lang=="zh"?"添加模型":"Add model")</button>
                                    </div>
                                    <p class="hint">@(I18n.Lang=="zh"?"模型名可任意自定义；同一站点可挂多个模型，随时切换当前使用项。":"Any model name is allowed; keep several per site and switch the active one anytime.")</p>
                                    @if (pfFetched.Count > 0)
                                    {
                                        <div class="model-catalog">
                                            <div class="mc-head">
                                                <span>@(I18n.Lang=="zh"?"站点可用模型":"Available models") @pfFetched.Count</span>
                                                <button type="button" @onclick="AddAllFetchedModels">@(I18n.Lang=="zh"?"全部添加":"Add all")</button>
                                            </div>
                                            <div class="mc-list">
                                                @foreach (var m in pfFetched)
                                                {
                                                    <div class="mc-row @(IsFetchedAdded(m.Id)?"added":"")" @onclick="()=>AddFetchedModel(m.Id)">
                                                        <span class="mc-id">@m.Id</span>
                                                        @if (!string.IsNullOrEmpty(m.DisplayName) && m.DisplayName != m.Id)
                                                        {
                                                            <span class="mc-name">@m.DisplayName</span>
                                                        }
                                                        <span class="mc-op">@(IsFetchedAdded(m.Id)?"✓":"+")</span>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }
                                    @if (pfModelsMsg != null)
                                    {
                                        <p class="msg @(pfModelsErr?"err":"")">@pfModelsMsg</p>
                                    }
                                    <datalist id="llm-model-presets">
                                        <option value="gpt-4o-mini"></option>
                                        <option value="gpt-4o"></option>
                                        <option value="claude-3-5-sonnet-latest"></option>
                                        <option value="gemini-1.5-flash"></option>
                                        <option value="deepseek-chat"></option>
                                        <option value="deepseek-reasoner"></option>
                                        <option value="qwen-plus"></option>
                                        <option value="moonshot-v1-8k"></option>
                                        <option value="glm-4-flash"></option>
                                    </datalist>

                                    <div class="form-section">@(I18n.Lang=="zh"?"重试设置":"Retry settings")</div>
                                    <div class="form-2col">
                                        <div>
                                            <label>@(I18n.Lang=="zh"?"重试策略":"Retry policy")</label>
                                            <select @bind="pfRetryPolicy">
                                                <option value="default">@(I18n.Lang=="zh"?"默认（仅临时错误）":"Default (transient only)")</option>
                                                <option value="transient">@(I18n.Lang=="zh"?"仅临时错误":"Transient only")</option>
                                                <option value="all">@(I18n.Lang=="zh"?"所有错误":"All errors")</option>
                                            </select>
                                        </div>
                                        <div>
                                            <label>@(I18n.Lang=="zh"?"最大重试次数":"Max retries")</label>
                                            <input type="number" min="0" max="10" @bind="pfMaxRetries" />
                                        </div>
                                    </div>
                                    <label>@(I18n.Lang=="zh"?"错误类型":"Error types")</label>
                                    <div class="retry-grid">
                                        <label><input type="checkbox" @bind="pfRetryEmpty" /> @(I18n.Lang=="zh"?"空响应":"Empty response")</label>
                                        <label><input type="checkbox" @bind="pfRetryFormat" /> @(I18n.Lang=="zh"?"响应格式错误":"Bad format")</label>
                                        <label><input type="checkbox" @bind="pfRetryQuota" /> @(I18n.Lang=="zh"?"配额已用尽":"Quota exhausted")</label>
                                        <label><input type="checkbox" @bind="pfRetryRateLimit" /> @(I18n.Lang=="zh"?"请求限流":"Rate limited")</label>
                                        <label><input type="checkbox" @bind="pfRetryServer" /> @(I18n.Lang=="zh"?"服务器错误":"Server error")</label>
                                        <label><input type="checkbox" @bind="pfRetryStreamEnd" /> @(I18n.Lang=="zh"?"流提前结束":"Stream cut")</label>
                                        <label><input type="checkbox" @bind="pfRetryTimeout" /> @(I18n.Lang=="zh"?"超时":"Timeout")</label>
                                        <label><input type="checkbox" @bind="pfRetryNetwork" /> @(I18n.Lang=="zh"?"网络错误":"Network error")</label>
                                    </div>
                                    <p class="hint">@(I18n.Lang=="zh"?"「默认」用内置临时错误集合；「仅临时错误」按上面勾选；「所有错误」不区分类型。":"Default uses built-in transient set; Transient uses the checked types; All retries every error.")</p>

                                    <div class="checks">
                                        <label><input type="checkbox" @bind="pfDefault" /> @(I18n.Lang=="zh"?"设为默认配置":"Set as default")</label>
                                    </div>

                                    <div class="form-section">@(I18n.Lang=="zh"?"从预设创建（可选）":"Preset (optional)")</div>
                                    <select @onchange="ApplyProviderPreset">
                                        <option value="">@(I18n.Lang=="zh"?"选择预设…":"Choose a preset…")</option>
                                        <option value="openai">OpenAI</option>
                                        <option value="anthropic">Anthropic</option>
                                        <option value="gemini">Gemini</option>
                                        <option value="deepseek">DeepSeek</option>
                                        <option value="qwen">通义千问</option>
                                        <option value="moonshot">Kimi 月之暗面</option>
                                        <option value="zhipu">智谱 GLM</option>
                                        <option value="siliconflow">硅基流动</option>
                                    </select>

                                    @if (pfMsg != null) { <p class="msg err">@pfMsg</p> }
                                    @if (!string.IsNullOrWhiteSpace(pfTestMsg))
                                    {
                                        <p class="msg @(pfTestOk?"":"err")">
                                            @(pfTestOk ? "✓ " : "✗ ")@pfTestMsg
                                            @(pfTestOk && pfTestMs > 0 ? $" · {pfTestMs} ms" : "")
                                        </p>
                                    }
                                </div>
                                <div class="modal-foot">
                                    <button @onclick="CloseProviderForm">@I18n["cancel"]</button>
                                    <button @onclick="DoTestProvider" disabled="@llmTesting">
                                        @(llmTesting ? (I18n.Lang=="zh"?"检测中…":"Testing…") : (I18n.Lang=="zh"?"检测":"Test"))
                                    </button>
                                    <button class="primary" @onclick="SaveProvider" disabled="@pfBusy">@I18n["save"]</button>
                                </div>
                            </div>
                        </div>
                    }
                }
                else if (view == "account")
                {
                    <div class="panel">
                        <div class="panel-title">@I18n["accountInfo"]</div>
                        <div class="kv-row"><span>@I18n["username"]</span><b>@user</b></div>
                        <div class="kv-row"><span>@I18n["role"]</span><b>@role</b></div>
                    </div>

                    <div class="panel">
                        <div class="panel-title">
                            @I18n["mfaSettings"]
                            <span class="badge @(myMfaEnabled?"ai":"manual")" style="margin-left:8px">
                                @(myMfaEnabled ? (I18n.Lang=="zh"?"已开启":"Enabled") : (I18n.Lang=="zh"?"未开启":"Disabled"))
                            </span>
                        </div>
                        <p class="hint">@(I18n.Lang=="zh"
                            ? "开启后登录需额外输入验证器 App 的 6 位动态码，显著提升账号安全性。"
                            : "When enabled, sign-in requires a 6-digit code from your authenticator app.")</p>

                        @if (!myMfaEnabled && mfaSetup is null)
                        {
                            <button class="primary" @onclick="StartMfaSetup" disabled="@mfaBusy">@I18n["enableMfa"]</button>
                        }

                        @if (mfaSetup is not null && !myMfaEnabled)
                        {
                            <div class="mfa-setup">
                                <p class="hint">@(I18n.Lang=="zh" ? "1. 在验证器 App（Google Authenticator / Microsoft Authenticator 等）中手动添加账号，密钥如下：" : "1. Add an account manually in your authenticator app with this key:")</p>
                                <div class="secret-box">
                                    <code>@mfaSetup.Secret</code>
                                    <button type="button" @onclick="()=>CopyText(mfaSetup.Secret)">@I18n["copy"]</button>
                                </div>
                                <p class="hint">@(I18n.Lang=="zh" ? "2. 输入 App 显示的 6 位动态码完成绑定：" : "2. Enter the 6-digit code shown in the app:")</p>
                                <div class="toolbar" style="margin:0">
                                    <input @bind="mfaCode" placeholder="000000" maxlength="6" style="width:130px" />
                                    <button class="primary" @onclick="ConfirmMfa" disabled="@mfaBusy">@I18n["confirmEnable"]</button>
                                    <button @onclick="CancelMfaSetup">@I18n["cancel"]</button>
                                </div>
                            </div>
                        }

                        @if (myMfaEnabled)
                        {
                            <label>@(I18n.Lang=="zh"?"输入当前动态码以关闭":"Enter current code to disable")</label>
                            <div class="toolbar" style="margin:0">
                                <input @bind="mfaCode" placeholder="000000" maxlength="6" style="width:130px" />
                                <button class="danger" @onclick="DisableMfaNow" disabled="@mfaBusy">@I18n["disableMfa"]</button>
                            </div>
                        }

                        @if (mfaMsg != null) { <p class="msg @(mfaErr?"err":"")">@mfaMsg</p> }
                    </div>

                    <div class="panel">
                        <div class="panel-title">@(I18n.Lang=="zh"?"导出数据":"Export data")</div>
                        <p class="hint">@(I18n.Lang=="zh"
                            ? "导出链接、发布库、数量统计与部署/备份信息（zip）。包内不含数据库口令、JWT 密钥、LLM API Key 或用户密码。"
                            : "Export links, libraries, counts and deployment/backup info as a zip. No secrets or password hashes are included.")</p>
                        <label>@(I18n.Lang=="zh"?"输入当前账号密码以确认":"Enter your password to confirm")</label>
                        <input type="password" @bind="exportPwd" @onkeydown="OnExportKey" placeholder="••••••••" autocomplete="current-password" />
                        <div class="btn-row">
                            <button class="primary" @onclick="DoExportPackage" disabled="@exportPkgBusy">
                                @(exportPkgBusy
                                    ? (I18n.Lang=="zh"?"正在打包…":"Packaging…")
                                    : (I18n.Lang=="zh"?"生成并下载压缩包":"Generate & download zip"))
                            </button>
                        </div>
                        @if (exportPkgMsg != null) { <p class="msg @(exportPkgErr?"err":"")">@exportPkgMsg</p> }
                    </div>

                    <div class="panel">
                        <div class="panel-title">@I18n["changePassword"]</div>
                        <label>@I18n["currentPassword"]</label>
                        <input type="password" @bind="oldPwd" />
                        <label>@I18n["newPassword"]</label>
                        <input type="password" @bind="newPwd2" placeholder="@(I18n.Lang=="zh"?"至少 8 位":"At least 8 characters")" />
                        <label>@I18n["confirmPassword"]</label>
                        <input type="password" @bind="newPwd3" />
                        <button class="primary" @onclick="DoChangePassword" disabled="@pwdBusy">@I18n["save"]</button>
                        @if (pwdMsg != null) { <p class="msg @(pwdErr?"err":"")">@pwdMsg</p> }
                    </div>
                }
            </div>

            @* 通用确认/重命名弹窗：替代浏览器原生 prompt/confirm，所有功能页共用 *@
            @if (askOpen)
            {
                <div class="modal-mask">
                    <div class="modal modal-sm" @onclick:stopPropagation="true">
                        <div class="modal-head">
                            <span>@askTitle</span>
                            <button class="modal-x" @onclick="CloseAsk">×</button>
                        </div>
                        <div class="modal-body">
                            <div class="warn-box">@askMessage</div>
                            @if (askKind == "rename")
                            {
                                <label>@(I18n.Lang=="zh"?"输入新名称":"New name")</label>
                                <input @bind="askValue" @onkeydown="OnAskKey" placeholder="@(I18n.Lang=="zh"?"新名称":"New name")" />
                            }
                        </div>
                        <div class="modal-foot">
                            <button @onclick="CloseAsk">@I18n["cancel"]</button>
                            <button class="@(askKind=="delete" ? "danger-solid" : "primary")" @onclick="ConfirmAsk" disabled="@askBusy">
                                @(askBusy ? (I18n.Lang=="zh"?"处理中…":"Working…") : (I18n.Lang=="zh"?"确认":"Confirm"))
                            </button>
                        </div>
                    </div>
                </div>
            }
        </main>
    </div>
}

@code {
    // ---- 登录 ----
    private bool loggedIn;
