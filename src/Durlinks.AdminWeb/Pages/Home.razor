    private async Task DoImportLinks()
    {
        if (currentLibId is null)
        {
            importMsg = I18n.Lang == "zh" ? "请先在左侧选择发布库" : "Select a library first";
            importErr = true; return;
        }
        var lines = pasteText.Split(['\n', '\r'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (lines.Length == 0)
        {
            importMsg = I18n.Lang == "zh" ? "没有可导入的链接" : "Nothing to import";
            importErr = true; return;
        }
        importBusy = true; importMsg = null;
        try
        {
            var items = lines.Select(t => new { rawText = t, title = (string?)null, linkType = (string?)null,
                groupName = (string?)null, platform = (string?)null, tags = new List<string>(), summary = (string?)null, recognized = false }).ToList();
            var (ok, body) = await Api.ImportLinksRaw(items, currentLibId);
            var (count, err) = ReadImportResult(ok, body);
            if (count is null)
            {
                importMsg = err ?? (I18n.Lang == "zh" ? "导入失败" : "Import failed");
                importErr = true; return;
            }
            importErr = false;
            importMsg = I18n.Lang == "zh"
                ? $"已导入 {count} 条到「{currentLibName}」"
                : $"Imported {count} link(s) into \"{currentLibName}\"";
            pasteText = ""; parseJson = null;
            await LoadLinks(); await LoadLibraries(); await LoadStats();
        }
        finally { importBusy = false; }
    }

