    private string? pfTestMsg;
    private bool pfTestOk;
    private long pfTestMs;
    // 发布管理两列折叠
    private bool navFolded;      // 左侧功能菜单（侧边栏）折叠
    private bool libFolded;      // 发布库列折叠；链接管理列始终显示
    private readonly HashSet<int> busyChannels = []; // 正在切换显示渠道的发布库，防重复点击
    private IBrowserFile? excelFile;
    private Dictionary<string, object> stats = new();

    // ---- 发布库 ----
    private List<LibraryDto> libraries = [];
    private int? currentLibId;
    private string? currentLibName;
    private bool libFormOpen, libEditing;
    private int libEditingId;
    private string libName = "", libDesc = "", libMsg = "", publishMsg = "";
    private bool libWeb = true, libClient = true;
    // 移动到/复制到
    private int targetLibId;
    private string? transferMsg;
    private bool transferErr;
    // ---- 链接新建/编辑 ----
