    /// <summary>刷新验证码：只换图片 URL 的 query，浏览器重新请求，后端覆盖 Cookie 中的 ticket。无需 API/JSON/JS 时序。</summary>
    private void RefreshCaptcha()
    {
        captchaSrc = "api/auth/captcha/image?t=" + Guid.NewGuid().ToString("N");
        captchaCode = "";
    }

    private async Task CheckUserMfa()
    {
        if (string.IsNullOrWhiteSpace(user)) { mfaNeeded = false; return; }
        mfaNeeded = await Api.CheckMfa(user);
        if (!mfaNeeded) totp = "";
    }

    private async Task OnLoginKey(KeyboardEventArgs e) { if (e.Key == "Enter") await DoLogin(); }

    private async Task DoLogin()
    {
        error = ""; busy = true;
        try
        {
            var res = await Api.Login(user, pwd, mfaNeeded && !string.IsNullOrWhiteSpace(totp) ? totp : null, "", captchaCode);
            if (!res.Ok)
            {
                error = res.Message == "Captcha is wrong or expired" ? I18n["captchaWrong"]
                      : res.Message == "MFA 动态码错误" ? (I18n.Lang=="zh"?"MFA 动态码错误":"MFA code error")
                      : I18n["loginFailed"];
                captchaCode = ""; RefreshCaptcha(); return;
            }
            if (res.Response != null)
            {
                await JS.InvokeVoidAsync("localStorage.setItem", "durlinks_token", res.Response.Token);
                await JS.InvokeVoidAsync("localStorage.setItem", "durlinks_user", res.Response.Username);
                await JS.InvokeVoidAsync("localStorage.setItem", "durlinks_role", res.Response.Role);
                user = res.Response.Username; role = res.Response.Role; loggedIn = true;
                await LoadAll();
            }
        }
        catch (Exception ex) { error = ex.Message; RefreshCaptcha(); }
        finally { busy = false; }
    }

    private async Task Logout()
    {
        try
        {
            await JS.InvokeVoidAsync("localStorage.removeItem", "durlinks_token");
            await JS.InvokeVoidAsync("localStorage.removeItem", "durlinks_user");
            await JS.InvokeVoidAsync("localStorage.removeItem", "durlinks_role");
        }
        catch { }
        // 回到静态登录页（控制台不再内置登录表单）
        Nav.NavigateTo("/", forceLoad: true);
    }

