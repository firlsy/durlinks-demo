    /// <summary>站点的模型清单；老数据只有 Model 时退化为单模型。</summary>
    private static List<string> ModelList(LlmConfigDto c) =>
        c.Models is { Count: > 0 } ? c.Models
        : string.IsNullOrWhiteSpace(c.Model) ? [] : [c.Model];

    private void AddPfModel()
    {
        var v = (pfNewModel ?? "").Trim();
        if (v.Length == 0) return;
        if (v.Length > 120) v = v[..120];
        if (!pfModels.Contains(v, StringComparer.OrdinalIgnoreCase)) pfModels.Add(v);
        pfModel = pfModels.First(m => string.Equals(m, v, StringComparison.OrdinalIgnoreCase)); // 新加的自动设为当前
        pfNewModel = "";
    }

    private void OnPfModelKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") AddPfModel();
    }

    private void RemovePfModel(string m)
    {
        pfModels.RemoveAll(x => string.Equals(x, m, StringComparison.OrdinalIgnoreCase));
        if (string.Equals(pfModel, m, StringComparison.OrdinalIgnoreCase))
            pfModel = pfModels.FirstOrDefault() ?? "";
    }

    /// <summary>勾选项 → 协议错误类型键。</summary>
    private List<string> CurrentRetryOn()
    {
        var list = new List<string>();
        if (pfRetryEmpty) list.Add("empty");
        if (pfRetryFormat) list.Add("format");
        if (pfRetryQuota) list.Add("quota");
        if (pfRetryRateLimit) list.Add("rate_limit");
        if (pfRetryServer) list.Add("server");
        if (pfRetryStreamEnd) list.Add("stream_end");
        if (pfRetryTimeout) list.Add("timeout");
        if (pfRetryNetwork) list.Add("network");
        return list;
    }

    private void ApplyRetryOn(List<string>? items)
    {
        var set = new HashSet<string>(items ?? [], StringComparer.OrdinalIgnoreCase);
        // 老配置没有该字段时按内置临时错误集合展示
        if (set.Count == 0) set = new HashSet<string>(["empty", "rate_limit", "server", "timeout", "network"], StringComparer.OrdinalIgnoreCase);
        pfRetryEmpty = set.Contains("empty");
        pfRetryFormat = set.Contains("format");
        pfRetryQuota = set.Contains("quota");
        pfRetryRateLimit = set.Contains("rate_limit");
        pfRetryServer = set.Contains("server");
        pfRetryStreamEnd = set.Contains("stream_end");
        pfRetryTimeout = set.Contains("timeout");
        pfRetryNetwork = set.Contains("network");
    }

    /// <summary>按当前表单（地址/密钥/协议）拉取站点可用模型；密钥留空时后端回退到已保存的。</summary>
    private async Task FetchProviderModels()
    {
        if (string.IsNullOrWhiteSpace(pfEndpoint))
        {
            pfModelsMsg = I18n.Lang == "zh" ? "请先填写 Base URL" : "Enter the base URL first";
            pfModelsErr = true; return;
        }
        pfFetchingModels = true; pfModelsMsg = null; pfModelsErr = false; pfFetched = [];
        try
        {
            var res = await Api.ListLlmModels(new LlmConfigDto
            {
                Id = pfId, Protocol = pfProtocol, ApiEndpoint = pfEndpoint, ApiKey = pfKey
            });
            if (res is null) { pfModelsMsg = I18n.Lang == "zh" ? "获取失败" : "Failed"; pfModelsErr = true; return; }
            pfFetched = res.Models;
            pfModelsErr = !res.Ok;
            pfModelsMsg = res.Ok
                ? (I18n.Lang == "zh" ? $"{res.Message}，点击条目加入清单" : $"{res.Message}. Click to add.")
                : res.Message;
        }
        finally { pfFetchingModels = false; }
    }

    private bool IsFetchedAdded(string id) =>
        pfModels.Any(x => string.Equals(x, id, StringComparison.OrdinalIgnoreCase));

    private void AddFetchedModel(string id)
    {
        if (!IsFetchedAdded(id)) pfModels.Add(id);
        if (string.IsNullOrWhiteSpace(pfModel)) pfModel = id;
    }

    private void AddAllFetchedModels()
    {
        foreach (var m in pfFetched) AddFetchedModel(m.Id);
        pfModelsErr = false;
        pfModelsMsg = I18n.Lang == "zh" ? $"已添加 {pfFetched.Count} 个模型" : $"Added {pfFetched.Count} models";
    }

    private void SetPfActive(string m) => pfModel = m;

    /// <summary>卡片上直接切换站点当前使用的模型（无需打开编辑框）。</summary>
    private async Task SwitchModel(LlmConfigDto c, string m)
    {
        if (string.Equals(c.Model, m, StringComparison.OrdinalIgnoreCase)) return;
        var (ok, msg) = await Api.SetLlmModel(c.Id, m);
        if (!ok)
        {
            llmMsg = I18n.Lang == "zh" ? "切换失败：" + msg : "Switch failed: " + msg;
            return;
        }
        llmConfigs = await Api.ListLlmConfigs();
        llmMsg = I18n.Lang == "zh" ? $"「{c.Name}」当前模型已切换为 {m}" : $"\"{c.Name}\" now uses {m}";
    }

    private async Task SaveProvider()
    {
        if (pfModels.Count == 0 && !string.IsNullOrWhiteSpace(pfNewModel)) AddPfModel();
        if (string.IsNullOrWhiteSpace(pfEndpoint) || pfModels.Count == 0)
        {
            pfMsg = I18n.Lang == "zh" ? "请填写 Base URL，并至少添加一个模型" : "Base URL and at least one model are required";
            return;
        }
        if (string.IsNullOrWhiteSpace(pfModel)) pfModel = pfModels[0];
        pfBusy = true; pfMsg = null;
        try
        {
            var (ok, _) = await Api.SaveLlmConfig(new LlmConfigDto
            {
                Id = pfId, Name = pfName, Protocol = pfProtocol,
                ApiEndpoint = pfEndpoint, ApiKey = pfKey, Model = pfModel, Models = [.. pfModels],
                RetryPolicy = pfRetryPolicy, MaxRetries = pfMaxRetries, RetryOn = CurrentRetryOn(),
                IsDefault = pfDefault
            });
            if (!ok) { pfMsg = I18n.Lang == "zh" ? "保存失败" : "Save failed"; return; }
            providerFormOpen = false;
            llmConfigs = await Api.ListLlmConfigs();
            llmMsg = I18n.Lang == "zh" ? "已保存" : "Saved";
        }
        finally { pfBusy = false; }
    }

    private void DeleteProvider(LlmConfigDto c)
    {
        askKind = "delete";
        askTitle = I18n.Lang == "zh" ? "删除模型站点" : "Delete provider";
        askMessage = I18n.Lang == "zh" ? $"确定删除「{c.Name}」？" : $"Delete \"{c.Name}\"?";
        askValue = "";
        askAction = async _ => { await Api.DeleteLlmConfig(c.Id); llmConfigs = await Api.ListLlmConfigs(); };
        askOpen = true;
    }

    private async Task MakeDefault(LlmConfigDto c)
    {
        await Api.SetDefaultLlmConfig(c.Id);
        llmConfigs = await Api.ListLlmConfigs();
        llmMsg = I18n.Lang == "zh" ? $"已将「{c.Name}」设为默认" : $"\"{c.Name}\" is now default";
    }

    private async Task TestProvider(LlmConfigDto c)
    {
        llmTesting = true; llmTestMsg = "";
        try
        {
            var (ok, msg, ms) = await Api.TestLlm(new LlmConfigDto
            {
                Id = c.Id, Protocol = c.Protocol, ApiEndpoint = c.ApiEndpoint,
                ApiKey = c.ApiKey, Model = c.Model
            });
            llmTestOk = ok; llmTestMsg = msg; llmTestMs = ms;
        }
        finally { llmTesting = false; }
    }

    private async Task DoTestProvider()
    {
        llmTesting = true; pfTestMsg = null;
        try
        {
            var (ok, msg, ms) = await Api.TestLlm(new LlmConfigDto
            {
                Id = pfId, Protocol = pfProtocol, ApiEndpoint = pfEndpoint,
                ApiKey = pfKey, Model = pfModel,
                RetryPolicy = pfRetryPolicy, MaxRetries = pfMaxRetries, RetryOn = CurrentRetryOn()
            });
            pfTestOk = ok; pfTestMsg = msg; pfTestMs = ms;
        }
        finally { llmTesting = false; }
    }

    private void ApplyProviderPreset(ChangeEventArgs e)
    {
        var v = e.Value?.ToString() ?? "";
        switch (v)
        {
            case "openai":
                pfName = "OpenAI"; pfProtocol = "openai";
                pfEndpoint = "https://api.openai.com/v1";
                pfModels = ["gpt-4o-mini", "gpt-4o"]; pfModel = "gpt-4o-mini"; break;
            case "anthropic":
                pfName = "Anthropic"; pfProtocol = "anthropic";
                pfEndpoint = "https://api.anthropic.com";
                pfModels = ["claude-3-5-sonnet-latest", "claude-3-5-haiku-latest"]; pfModel = "claude-3-5-sonnet-latest"; break;
            case "gemini":
                pfName = "Gemini"; pfProtocol = "gemini";
                pfEndpoint = "https://generativelanguage.googleapis.com";
                pfModels = ["gemini-1.5-flash", "gemini-1.5-pro"]; pfModel = "gemini-1.5-flash"; break;
            case "deepseek":
                pfName = "DeepSeek"; pfProtocol = "openai";
                pfEndpoint = "https://api.deepseek.com/v1";
                pfModels = ["deepseek-chat", "deepseek-reasoner"]; pfModel = "deepseek-chat"; break;
            case "qwen":
                pfName = "通义千问"; pfProtocol = "openai";
                pfEndpoint = "https://dashscope.aliyuncs.com/compatible-mode/v1";
                pfModels = ["qwen-plus", "qwen-turbo", "qwen-max"]; pfModel = "qwen-plus"; break;
            case "moonshot":
                pfName = "Kimi 月之暗面"; pfProtocol = "openai";
                pfEndpoint = "https://api.moonshot.cn/v1";
                pfModels = ["moonshot-v1-8k", "moonshot-v1-32k"]; pfModel = "moonshot-v1-8k"; break;
            case "zhipu":
                pfName = "智谱 GLM"; pfProtocol = "openai";
                pfEndpoint = "https://open.bigmodel.cn/api/paas/v4";
                pfModels = ["glm-4-flash", "glm-4-plus"]; pfModel = "glm-4-flash"; break;
            case "siliconflow":
                pfName = "硅基流动"; pfProtocol = "openai";
                pfEndpoint = "https://api.siliconflow.cn/v1";
                pfModels = ["Qwen/Qwen2.5-7B-Instruct"]; pfModel = "Qwen/Qwen2.5-7B-Instruct"; break;
        }
        pfNewModel = "";
    }

    public void Dispose()
    {
        I18n.OnChange -= StateHasChanged;
        enrichTimer?.Dispose();
    }
}
