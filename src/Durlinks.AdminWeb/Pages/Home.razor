    private async Task SaveLinkForm()
    {
        linkFormMsg = "";
        if (linkEditing)
        {
            var (ok, msg) = await Api.UpdateLink(linkEditingId, new LinkUpdateRequest
            {
                LibraryId = currentLibId, Title = lfTitle, Url = lfUrl, GroupName = NormalizeMulti(lfGroup),
                Platform = NormalizeMulti(lfPlatform), LinkType = lfLinkType,
                ExtractCode = lfExtractCode, ExpireAt = lfExpireAt, Version = lfVersion,
                Remark = lfRemark, Tags = ParseTags(lfSelectedTagsText)
            });
            if (!ok) { linkFormMsg = msg ?? "保存失败"; return; }
        }
        else
        {
            var drafts = linkDrafts.Where(d => !string.IsNullOrWhiteSpace(d.Title) || !string.IsNullOrWhiteSpace(d.Url)).ToList();
            if (drafts.Count == 0) { linkFormMsg = I18n.Lang == "zh" ? "请至少填写一条链接" : "Enter at least one link"; return; }
            var created = 0;
            for (var i = 0; i < drafts.Count; i++)
            {
                var draft = drafts[i];
                var (ok, msg) = await Api.CreateLink(new LinkCreateRequest
                {
                    LibraryId = currentLibId, Title = draft.Title, Url = draft.Url, GroupName = NormalizeMulti(draft.GroupName),
                    Platform = NormalizeMulti(draft.Platform), LinkType = draft.LinkType,
                    ExtractCode = draft.ExtractCode, ExpireAt = draft.ExpireAt, Version = draft.Version,
                    Remark = draft.Remark,
                    Tags = draft.Tags
                });
                if (!ok)
                {
                    linkFormMsg = created > 0
                        ? (I18n.Lang == "zh" ? $"已保存 {created} 条；第 {i + 1} 条失败：{msg ?? "保存失败"}" : $"Saved {created}; row {i + 1} failed: {msg ?? "Save failed"}")
                        : (msg ?? (I18n.Lang == "zh" ? $"第 {i + 1} 条保存失败" : $"Row {i + 1} failed"));
                    await LoadLinks();
                    await LoadLibraries();
                    return;
                }
                created++;
            }
        }
        // 把本次输入的新选项写回字典，实现「可选也可新建」
        await EnsureCategoriesFromForm();
        linkFormOpen = false;
        await LoadLinks();
        await LoadLibraries();
    }

    /// <summary>新建/编辑时输入的新分组、平台、标签、链接形式自动补入字典（已存在则忽略）。</summary>
    private async Task EnsureCategoriesFromForm()
    {
        var groups = new HashSet<string>(StringComparer.Ordinal);
        var platforms = new HashSet<string>(StringComparer.Ordinal);
        var tags = new HashSet<string>(StringComparer.Ordinal);
        var types = new HashSet<string>(StringComparer.Ordinal);
        if (linkEditing)
        {
            foreach (var g in ParseTags(lfGroup)) groups.Add(g);
            foreach (var p in ParseTags(lfPlatform)) platforms.Add(p);
            foreach (var t in ParseTags(lfSelectedTagsText)) tags.Add(t);
            if (!string.IsNullOrWhiteSpace(lfLinkType)) types.Add(lfLinkType.Trim());
        }
        else
        {
            foreach (var d in linkDrafts)
            {
                foreach (var g in ParseTags(d.GroupName)) groups.Add(g);
                foreach (var p in ParseTags(d.Platform)) platforms.Add(p);
                foreach (var t in d.Tags) tags.Add(t);
                if (!string.IsNullOrWhiteSpace(d.LinkType)) types.Add(d.LinkType.Trim());
            }
        }
        // 只提交字典里尚不存在的值，避免已存在项产生 409 噪音
        var known = new (string kind, HashSet<string> set)[]
        {
            ("group", categoryGroups.ToHashSet(StringComparer.Ordinal)),
            ("platform", categoryPlatforms.ToHashSet(StringComparer.Ordinal)),
            ("type", categoryLinkTypes.ToHashSet(StringComparer.Ordinal)),
            ("tag", categoryTags.ToHashSet(StringComparer.Ordinal))
        };
        foreach (var (kind, values) in new (string, IEnumerable<string>)[]
                 { ("group", groups), ("platform", platforms), ("type", types), ("tag", tags) })
        {
            var existing = known.First(x => x.kind == kind).set;
            foreach (var name in values.Where(x => !existing.Contains(x)))
                await Api.CreateCategory(kind, name);
        }
        await LoadCategories();
    }
