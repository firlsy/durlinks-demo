    private async Task StartBatch()
    {
        try
        {
            // 前端先钳制：空值/0/负数一律按 100，避免误触大批量消耗额度
            var limit = enrichLimit <= 0 ? 100 : Math.Min(enrichLimit, 100000);
            enrichLimit = limit;
            var (ok, msg) = await Api.StartBatchEnrich(new BatchEnrichRequest
            {
                Mode = enrichMode, Limit = limit, Concurrency = 3,
                LibraryId = currentLibId ?? 0
            });
            enrichStatus = await Api.GetBatchEnrichStatus();
            if (!ok) return; // 已在运行等冲突场景，仅刷新状态
            StartEnrichPolling();
        }
        catch { enrichStatus = await Api.GetBatchEnrichStatus(); }
    }

    /// <summary>启动进度轮询；重复调用会先释放旧 Timer。</summary>
    private void StartEnrichPolling()
    {
        enrichTimer?.Dispose();
        importTimer?.Dispose();
        enrichTimer = new System.Threading.Timer(async _ =>
        {
            var s = await Api.GetBatchEnrichStatus();
            await InvokeAsync(() => { enrichStatus = s; StateHasChanged(); });
            if (s == null || !s.Running)
            {
                enrichTimer?.Dispose();
                enrichTimer = null;
                await InvokeAsync(async () => { await LoadLinks(); await LoadStats(); });
            }
        }, null, 1500, 1500);
    }

