    private async Task DoImportExcel()
    {
        if (excelFile is null)
        {
            importMsg = I18n.Lang == "zh" ? "请先选择文件" : "Select a file first";
            importErr = true; return;
        }
        if (currentLibId is null)
        {
            importMsg = I18n.Lang == "zh" ? "请先在左侧选择发布库" : "Select a library first";
            importErr = true; return;
        }
        importBusy = true; importMsg = null; importErr = false;
        try
        {
            using var content = new MultipartFormDataContent();
            // 单文件上限与服务端一致（50MB）；真正的内存控制靠服务端流式解析
            content.Add(new StreamContent(excelFile.OpenReadStream(50L * 1024 * 1024)), "file", excelFile.Name);
            var (ok, body) = await Api.StartExcelImport(content, currentLibId);
            if (!ok)
            {
                importMsg = ReadMessage(body) ?? (I18n.Lang == "zh" ? "启动导入失败" : "Failed to start import");
                importErr = true; return;
            }
            excelFile = null;
            importStatus = await Api.ExcelImportStatus();
            StartImportPolling();
        }
        finally { importBusy = false; }
    }

    /// <summary>轮询后台导入进度；完成后刷新列表并停表。</summary>
    private void StartImportPolling()
    {
        importTimer?.Dispose();
        importTimer = new Timer(async _ => await PollImportAsync(), null, 0, 800);
    }

    private async Task PollImportAsync()
    {
        if (importPolling) return;   // 防止上一次未完成时重入
        importPolling = true;
        try
        {
            var st = await Api.ExcelImportStatus();
            if (st is null) return;
            await InvokeAsync(() => { importStatus = st; StateHasChanged(); });
            if (st.Running) return;

            importTimer?.Dispose(); importTimer = null;
            await InvokeAsync(async () =>
            {
                importMsg = st.Message;
                importErr = st.Imported == 0 && st.Failed > 0;
                await LoadLinks(); await LoadLibraries(); await LoadStats();
                StateHasChanged();
            });
        }
        finally { importPolling = false; }
    }

    private async Task CancelExcelImport()
    {
        await Api.CancelExcelImport();
        importMsg = I18n.Lang == "zh" ? "已请求取消，当前批次处理完即停止…" : "Cancelling after current batch…";
        await PollImportAsync();
    }

    private static string? ReadMessage(string body)
    {
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(body);
            if (doc.RootElement.TryGetProperty("message", out var m)) return m.GetString();
            if (doc.RootElement.TryGetProperty("status", out var st)
                && st.TryGetProperty("message", out var sm)) return sm.GetString();
        }
        catch { }
        return body.Length > 200 ? body[..200] : null;
    }

    /// <summary>导入接口统一返回 { imported } 或 { message }，这里做一次安全解析。</summary>
    private static (int? imported, string? message) ReadImportResult(bool ok, string body)
    {
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(body);
            var root = doc.RootElement;
            if (root.TryGetProperty("imported", out var n) && n.ValueKind == System.Text.Json.JsonValueKind.Number)
                return (n.GetInt32(), null);
            if (root.TryGetProperty("message", out var m) && m.ValueKind == System.Text.Json.JsonValueKind.String)
                return (null, m.GetString());
        }
        catch { /* 非 JSON，走下面的兜底 */ }
        return (null, ok ? null : (body.Length > 200 ? body[..200] : body));
    }
