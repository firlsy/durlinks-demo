    private async Task DeleteSelectedCategories()
    {
        categoryMsg = ""; categoryErr = false;
        var selected = categorySelected.ToDictionary(x => x.Key, x => x.Value.ToList());
        var deleted = 0; var skipped = 0;
        foreach (var (kind, names) in selected)
        {
            if (names.Count == 0) continue;
            var (result, msg) = await Api.BatchDeleteCategory(kind, names);
            if (result is null) { categoryMsg = msg ?? "批量删除失败"; categoryErr = true; continue; }
            deleted += result.Deleted.Count;
            skipped += result.Skipped.Count;
            var set = CategorySelection(kind);
            foreach (var name in result.Deleted) set.Remove(name);
        }
        await LoadCategories();
        categoryMsg = I18n.Lang == "zh"
            ? $"已删除 {deleted} 项" + (skipped > 0 ? $"，跳过 {skipped} 项（仍被链接使用或不存在）" : "")
            : $"Deleted {deleted} options" + (skipped > 0 ? $", skipped {skipped} (in use or missing)" : "");
    }

