    private int pageCount => pageSize <= 0 ? 1 : Math.Max(1, (int)Math.Ceiling(total / (double)pageSize));

    private int loadSeq; // 搜索请求序号：快速输入时丢弃过期响应，防止旧结果覆盖新结果

    private async Task LoadLinks()
    {
        var seq = ++loadSeq;
        ImportSource? src = string.IsNullOrEmpty(srcFilter) ? null : (ImportSource)int.Parse(srcFilter);
        if (page < 1) page = 1;
        var r = await Api.ListLinks(new LinkQuery { Q = q, ImportSource = src, LibraryId = currentLibId, Page = page, PageSize = pageSize });
        if (seq != loadSeq) return; // 已经有更新的请求发出，这次的结果作废
        total = r?.Total ?? 0;
        // 删除/筛选后当前页可能越界，回退到最后一页再拉一次
        if (total > 0 && page > pageCount)
        {
            page = pageCount;
            r = await Api.ListLinks(new LinkQuery { Q = q, ImportSource = src, LibraryId = currentLibId, Page = page, PageSize = pageSize });
            if (seq != loadSeq) return;
            total = r?.Total ?? 0;
        }
        // 结果为空时页码归 1，否则底部会显示「第 5 / 1 页」这种鬼东西
        if (total == 0) page = 1;
        links = r?.Items ?? [];
    }

