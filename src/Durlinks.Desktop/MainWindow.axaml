<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Durlinks.Desktop"
        xmlns:auto="using:Avalonia.Automation"
        x:Class="Durlinks.Desktop.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="durlinks · 链接库"
        Width="1100" Height="760" MinWidth="320" MinHeight="480"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Window.Resources>
        <!-- ============ 复用的小模板 ============ -->
        <DataTemplate x:Key="FilterChipTemplate" x:DataType="vm:FilterChipVm">
            <ToggleButton Classes="chip" Content="{Binding Display}"
                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                          ToolTip.Tip="{Binding ToolTipText}"
                          Tag="{Binding}" Click="FilterChip_Click"/>
        </DataTemplate>

        <!-- 每页条数选项：Flyout 与移动筛选面板共用，选中态由 VM 驱动（零新增颜色/字号） -->
        <DataTemplate x:Key="PageSizeOptionTemplate" x:DataType="vm:PageSizeOptionVm">
            <Button Classes="pageSizeOption" Tag="{Binding Value}" Click="PageSizeOption_Click"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    MinHeight="32" Padding="12,4"
                    auto:AutomationProperties.Name="{Binding Value, StringFormat=每页{0}条}">
                <Grid>
                    <Border Background="{DynamicResource ChipActiveBgBrush}"
                            BorderBrush="{DynamicResource AppAccentMutedBrush}" BorderThickness="1"
                            CornerRadius="{DynamicResource ControlRadius}" IsVisible="{Binding IsSelected}"/>
                    <TextBlock Text="{Binding Value}" FontSize="{DynamicResource AuxFontSize}"
                               Foreground="{DynamicResource ChipFgBrush}" IsVisible="{Binding !IsSelected}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Value}" FontSize="{DynamicResource AuxFontSize}"
                               Foreground="{DynamicResource ChipActiveFgBrush}" FontWeight="{DynamicResource WeightMedium}"
                               IsVisible="{Binding IsSelected}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Button>
        </DataTemplate>

        <!-- 发布库条目：左侧 rail 与移动抽屉共用同一模板（抽屉靠 Window.mobile 提升到 44 触控高度）。
             结构与文件管理器侧栏一致：圆形字标 + 名称 + 条数，选中态是整行浅色带（无圆角、无竖条）。 -->
        <DataTemplate x:Key="LibraryRailItemTemplate" x:DataType="vm:LibraryChipVm">
            <Button Classes="railItem" Tag="{Binding}" Click="LibraryChip_Click"
                    ToolTip.Tip="{Binding Name}"
                    auto:AutomationProperties.Name="{Binding AccessibleName}">
                <Border Classes="railItemBg" Classes.selected="{Binding IsSelected}">
                    <Panel>
                        <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                            <Border Grid.Column="0" Classes="railAvatar" Classes.selected="{Binding IsSelected}"
                                    Width="{DynamicResource RailAvatarSize}" Height="{DynamicResource RailAvatarSize}"
                                    Margin="14,0,10,0">
                                <TextBlock Classes="railAvatarText" Classes.selected="{Binding IsSelected}"
                                           Text="{Binding Initial}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="1" Classes="railName" Classes.selected="{Binding IsSelected}"
                                       Text="{Binding Name}" Margin="0,0,8,0" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" MaxLines="1"
                                       ToolTip.Tip="{Binding Name}"/>
                            <TextBlock Grid.Column="2" Classes="railCount" Classes.selected="{Binding IsSelected}"
                                       Text="{Binding LinkCount}" Margin="0,0,12,0"
                                       VerticalAlignment="Center" IsVisible="{Binding ShowCount}"/>
                        </Grid>
                        <!-- 键盘焦点环（:focus-visible 时才上色） -->
                        <Border Classes="railFocus" IsHitTestVisible="False"/>
                    </Panel>
                </Border>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="ToastTemplate" x:DataType="vm:ToastItem">
            <Border Margin="0,4,0,0" Padding="14,10" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                    CornerRadius="{DynamicResource ControlRadius}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border Width="3" Height="18" CornerRadius="2" Background="{DynamicResource SuccessBaseBrush}" IsVisible="{Binding IsSuccess}"/>
                    <Border Width="3" Height="18" CornerRadius="2" Background="{DynamicResource InfoBaseBrush}" IsVisible="{Binding IsInfo}"/>
                    <Border Width="3" Height="18" CornerRadius="2" Background="{DynamicResource WarningBaseBrush}" IsVisible="{Binding IsWarning}"/>
                    <Border Width="3" Height="18" CornerRadius="2" Background="{DynamicResource ErrorBaseBrush}" IsVisible="{Binding IsError}"/>
                    <TextBlock Text="{Binding Message}" FontSize="{DynamicResource BodyFontSize}"
                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- ============ 设置面板（桌面 Popover / 平板 Dialog / 移动全屏共用同一模板） ============ -->
        <ControlTemplate x:Key="SettingsFormTemplate">
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}"
                    BorderThickness="1" CornerRadius="{DynamicResource PopoverRadius}" Padding="20">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="后端设置" FontSize="{DynamicResource SectionTitleFontSize}"
                                       FontWeight="{DynamicResource WeightSemiBold}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="修改地址后请先测试连接" FontSize="{DynamicResource AuxFontSize}"
                                       Foreground="{DynamicResource TextTertiaryBrush}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="iconBtn" Click="CloseSettings_Click"
                                auto:AutomationProperties.Name="关闭设置">
                            <PathIcon Data="M18.3 5.7 12 12l6.3 6.3-1.4 1.4L10.6 13.4 4.3 19.7 2.9 18.3 9.2 12 2.9 5.7 4.3 4.3l6.3 6.3 6.3-6.3z"
                                      Width="16" Height="16" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Button>
                    </Grid>

                    <StackPanel Spacing="6">
                        <TextBlock Text="后端地址" FontSize="{DynamicResource BodyFontSize}"
                                   FontWeight="{DynamicResource WeightMedium}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBox x:Name="SettingsUrlBox" Text="{Binding SettingsUrl, Mode=TwoWay}"
                                 PlaceholderText="https://demo.durlists.de5.net:8080"
                                 LostFocus="SettingsUrl_LostFocus" Loaded="SettingsUrlBox_Loaded"
                                 FontFamily="{DynamicResource MonoFontFamily}" FontSize="{DynamicResource MonoFontSize}"
                                 Height="40" VerticalContentAlignment="Center"
                                 auto:AutomationProperties.Name="后端地址输入框"/>
                        <TextBlock Text="仅支持 http/https，测试成功或失焦时保存"
                                   FontSize="{DynamicResource CaptionFontSize}" Foreground="{DynamicResource TextTertiaryBrush}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="primary" Content="测试连接" Click="TestConnection_Click"
                                IsEnabled="{Binding CanTestConnection}" MinWidth="96"
                                auto:AutomationProperties.Name="测试连接"/>
                        <Button Classes="ghostBtn" Content="恢复默认" Click="ResetBackend_Click"
                                auto:AutomationProperties.Name="恢复默认地址"/>
                    </StackPanel>

                    <Border Padding="10" CornerRadius="{DynamicResource ControlRadius}"
                            Background="{DynamicResource SuccessBgBrush}" IsVisible="{Binding TestSuccess}">
                        <TextBlock Text="{Binding TestMessage}" FontSize="{DynamicResource AuxFontSize}"
                                   Foreground="{DynamicResource SuccessTextBrush}"/>
                    </Border>
                    <Border Padding="10" CornerRadius="{DynamicResource ControlRadius}"
                            Background="{DynamicResource ErrorBgBrush}" IsVisible="{Binding TestFailed}">
                        <TextBlock Text="{Binding TestMessage}" FontSize="{DynamicResource AuxFontSize}"
                                   Foreground="{DynamicResource ErrorTextBrush}" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </Border>
        </ControlTemplate>

        <!-- ============ 筛选面板（平板 / 移动共用） ============ -->
        <ControlTemplate x:Key="FilterPanelTemplate">
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}"
                    BorderThickness="1" CornerRadius="{DynamicResource PopoverRadius}" Padding="20"
                    MaxWidth="520">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="筛选" FontSize="{DynamicResource SectionTitleFontSize}"
                                   FontWeight="{DynamicResource WeightSemiBold}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <Button Grid.Column="1" Classes="iconBtn" Click="CloseFilterPanel_Click"
                                auto:AutomationProperties.Name="关闭筛选">
                            <PathIcon Data="M18.3 5.7 12 12l6.3 6.3-1.4 1.4L10.6 13.4 4.3 19.7 2.9 18.3 9.2 12 2.9 5.7 4.3 4.3l6.3 6.3 6.3-6.3z"
                                      Width="16" Height="16" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Button>
                    </Grid>

                    <StackPanel Spacing="6">
                        <TextBlock Text="分组（可多选）" FontSize="{DynamicResource CaptionFontSize}"
                                   Foreground="{DynamicResource TextTertiaryBrush}"/>
                        <ItemsControl ItemsSource="{Binding GroupChips}" ItemTemplate="{DynamicResource FilterChipTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="标签（可多选）" FontSize="{DynamicResource CaptionFontSize}"
                                   Foreground="{DynamicResource TextTertiaryBrush}"/>
                        <ItemsControl ItemsSource="{Binding TagChips}" ItemTemplate="{DynamicResource FilterChipTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="平台（可多选）" FontSize="{DynamicResource CaptionFontSize}"
                                   Foreground="{DynamicResource TextTertiaryBrush}"/>
                        <ItemsControl ItemsSource="{Binding PlatformChips}" ItemTemplate="{DynamicResource FilterChipTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="来源（单选）" FontSize="{DynamicResource CaptionFontSize}"
                                   Foreground="{DynamicResource TextTertiaryBrush}"/>
                        <ItemsControl ItemsSource="{Binding SourceChips}" ItemTemplate="{DynamicResource FilterChipTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>

                    <!-- 移动端每页条数入口（触控 MinHeight 44） -->
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalAlignment="Center">
                        <TextBlock Grid.Column="0" Text="每页" FontSize="{DynamicResource CaptionFontSize}"
                                   Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                        <Button x:Name="PageSizePanelButton" Grid.Column="1" Classes="ghostBtn" MinHeight="44"
                                Content="{Binding PageSize}" HorizontalAlignment="Left" MinWidth="72"
                                auto:AutomationProperties.Name="选择每页条数">
                            <Button.Flyout>
                                <Flyout Placement="Top">
                                    <Border Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                                            CornerRadius="{DynamicResource PopoverRadius}" Padding="4">
                                        <ItemsControl ItemsSource="{Binding PageSizeOptions}"
                                                      ItemTemplate="{DynamicResource PageSizeOptionTemplate}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </Border>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Classes="ghostBtn" Content="清除全部" Click="ClearFilters_Click"
                                IsVisible="{Binding HasActiveFilters}" auto:AutomationProperties.Name="清除全部筛选"/>
                        <Button Classes="primary" Content="应用" Click="ApplyFilters_Click"
                                auto:AutomationProperties.Name="应用筛选"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </ControlTemplate>
    </Window.Resources>

    <!-- Row0 工具栏（品牌 + 动作 + 搜索） / Row1 工作区（侧栏 + 表格） / Row2 进度与状态栏 -->
    <Grid RowDefinitions="Auto,*,Auto">
        <!-- ============ Row0：工具栏 ============ -->
        <Border Grid.Row="0" Height="{Binding BrandBarHeight}" Background="{DynamicResource SurfaceSunkenBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="10,0,10,0">
                <!-- 品牌 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="{Binding BrandLeftPadding}" Spacing="8">
                    <Image Width="22" Height="22" Stretch="Uniform"
                           Source="avares://Durlinks.Desktop/Assets/favicon.png"
                           RenderOptions.BitmapInterpolationMode="HighQuality"
                           auto:AutomationProperties.Name="durlinks 图标"/>
                    <TextBlock Text="durlinks" FontFamily="{DynamicResource SansFontFamily}"
                               FontSize="{DynamicResource SectionTitleFontSize}" FontWeight="{DynamicResource WeightSemiBold}"
                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <Border Padding="5,1" CornerRadius="{DynamicResource ChipRadius}"
                            Background="{DynamicResource ChipBgBrush}" VerticalAlignment="Center">
                        <TextBlock Text="DEMO" FontSize="{DynamicResource CaptionFontSize}"
                                   FontWeight="{DynamicResource WeightMedium}"
                                   Foreground="{DynamicResource TextTertiaryBrush}"/>
                    </Border>
                </StackPanel>

                <!-- 动作按钮：图标在左、文字在右；移动档只留图标 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2"
                            Margin="18,0,0,0" VerticalAlignment="Center">
                    <Button Classes="toolBtn" Click="Refresh_Click" ToolTip.Tip="重新加载当前页"
                            auto:AutomationProperties.Name="刷新">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <PathIcon Data="F0 M12 4V1L8 5l4 4V6a6 6 0 1 1-6 6H4a8 8 0 1 0 8-8z"
                                      Width="15" Height="15" Foreground="{DynamicResource AppAccentBrush}"/>
                            <TextBlock Classes="toolLabel" Text="刷新" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="toolBtn" Click="CopyPage_Click" ToolTip.Tip="复制当前页全部链接"
                            auto:AutomationProperties.Name="复制本页链接">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <PathIcon Data="F0 M16 1H4a2 2 0 0 0-2 2v14h2V3h12V1zm3 4H8a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h11a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2zm0 16H8V7h11v14z"
                                      Width="15" Height="15" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Classes="toolLabel" Text="复制本页" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Border Width="1" Height="18" Margin="8,0" VerticalAlignment="Center"
                            Background="{DynamicResource BorderDefaultBrush}"/>
                </StackPanel>

                <!-- 搜索：靠右，宽度由 ApplyLayout 按布局档写入 -->
                <Grid x:Name="SearchHost" Grid.Column="2" Height="{Binding SearchBoxHeight}"
                      MaxWidth="320" HorizontalAlignment="Right" VerticalAlignment="Center"
                      ToolTip.Tip="{Binding ShortcutHint}">
                    <Border Classes="searchGlow" x:Name="SearchGlow"/>
                    <Border Classes="searchBorder" x:Name="SearchBorder"/>
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <PathIcon Grid.Column="0" Margin="12,0,0,0" VerticalAlignment="Center"
                                  Data="F0 M9.5 3a6.5 6.5 0 1 0 0 13 6.5 6.5 0 0 0 0-13zm0 2a4.5 4.5 0 1 1 0 9 4.5 4.5 0 0 1 0-9zM15.5 14.5l5 5-1.4 1.4-5-5z"
                                  Width="15" Height="15" Foreground="{DynamicResource TextTertiaryBrush}"/>
                        <TextBox Grid.Column="1" x:Name="SearchBox" Text="{Binding Keyword, Mode=TwoWay}"
                                 PlaceholderText="搜索名称、链接、摘要…" BorderThickness="0" Background="Transparent"
                                 VerticalContentAlignment="Center" FontSize="{DynamicResource BodyFontSize}"
                                 FontFamily="{DynamicResource SansFontFamily}"
                                 TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown"
                                 auto:AutomationProperties.Name="搜索链接"/>
                        <Panel Grid.Column="2" Width="18" Height="18" Margin="0,0,8,0"
                               VerticalAlignment="Center" ClipToBounds="True"
                               IsVisible="{Binding IsLoadingVisible}">
                            <!-- 脉冲点：ProgressBar 的不确定态动画会横向溢出 18px 边界盖住搜索提示，改用点状指示 -->
                            <Ellipse Width="7" Height="7" HorizontalAlignment="Center" VerticalAlignment="Center"
                                     Fill="{DynamicResource AppAccentBrush}">
                                <Ellipse.Styles>
                                    <Style Selector="Ellipse">
                                        <Style.Animations>
                                            <Animation Duration="0:0:0.85" IterationCount="INFINITE"
                                                       PlaybackDirection="Alternate">
                                                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.22"/></KeyFrame>
                                                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                                            </Animation>
                                        </Style.Animations>
                                    </Style>
                                </Ellipse.Styles>
                            </Ellipse>
                        </Panel>
                    </Grid>
                </Grid>

                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center"
                            Margin="8,0,0,0">
                    <Button Classes="iconBtn" Click="ThemeButton_Click" auto:AutomationProperties.Name="{Binding ThemeTooltip}">
                        <Panel>
                            <PathIcon IsVisible="{Binding IsSystemTheme}"
                                      Data="F0 M3 4h18a1 1 0 0 1 1 1v11a1 1 0 0 1-1 1h-7v2h3v2H7v-2h3v-2H3a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1zm1 2v9h16V6H4z"
                                      Width="17" Height="17" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <PathIcon IsVisible="{Binding IsLightTheme}"
                                      Data="F0 M12 7a5 5 0 1 0 0 10 5 5 0 0 0 0-10zm0 2a3 3 0 1 1 0 6 3 3 0 0 1 0-6zM11 1h2v3h-2V1zm0 19h2v3h-2v-3zM1 11h3v2H1v-2zm19 0h3v2h-3v-2zM3.6 5.2 5 3.8l2.1 2.1-1.4 1.4L3.6 5.2zm13.3 13.3 1.4-1.4 2.1 2.1-1.4 1.4-2.1-2.1zM18.4 5.2l1.4 1.4-2.1 2.1-1.4-1.4 2.1-2.1zM5.1 18.5l1.4 1.4L4.4 22l-1.4-1.4 2.1-2.1z"
                                      Width="17" Height="17" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <PathIcon IsVisible="{Binding IsDarkTheme}"
                                      Data="M12.5 2a9 9 0 1 0 9.5 9.5A7 7 0 0 1 12.5 2z"
                                      Width="17" Height="17" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Panel>
                    </Button>
                    <Button Classes="iconBtn" Click="SettingsButton_Click" auto:AutomationProperties.Name="打开后端设置">
                        <PathIcon Data="F0 M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58a.5.5 0 0 0 .12-.64l-1.92-3.32a.5.5 0 0 0-.61-.22l-2.39.96a7.03 7.03 0 0 0-1.62-.94l-.36-2.54a.5.5 0 0 0-.5-.42h-3.84a.5.5 0 0 0-.5.42l-.36 2.54c-.59.24-1.13.56-1.62.94l-2.39-.96a.5.5 0 0 0-.61.22L2.72 8.84a.5.5 0 0 0 .12.64l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58a.5.5 0 0 0-.12.64l1.92 3.32c.12.22.39.3.61.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.25.42.5.42h3.84c.25 0 .45-.18.5-.42l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.49 0 .61-.22l1.92-3.32a.5.5 0 0 0-.12-.64l-2.03-1.58zM12 15.6a3.6 3.6 0 1 1 0-7.2 3.6 3.6 0 0 1 0 7.2z"
                                  Width="17" Height="17" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ Row1：工作区（左侧栏 + 右内容） ============ -->
        <Grid x:Name="WorkspaceGrid" Grid.Row="1" ColumnDefinitions="Auto,*">
            <!-- 发布库侧栏：平板及以上常驻，Mobile 由 ApplyLayout 隐藏；白色底 + 右缘 1px 分隔 -->
            <Border x:Name="LibraryRail" Grid.Column="0" IsVisible="False"
                    Width="{DynamicResource LibraryRailWidth}"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,1,0"
                    KeyboardNavigation.TabNavigation="Once" KeyDown="LibraryRail_KeyDown">
                <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">
                    <TextBlock Grid.Row="0" Classes="railSection" Text="发布库" Margin="14,12,12,6"
                               auto:AutomationProperties.Name="发布库"/>

                    <!-- 吸顶「全部发布库」：在 ScrollViewer 之外，滚动库列表时恒可见 -->
                    <StackPanel Grid.Row="1">
                        <ContentControl Content="{Binding AllLibraryChip}"
                                        ContentTemplate="{DynamicResource LibraryRailItemTemplate}"
                                        HorizontalContentAlignment="Stretch"/>
                        <Border Height="1" Margin="0,8,0,8" Background="{DynamicResource BorderSubtleBrush}"/>
                    </StackPanel>

                    <ScrollViewer x:Name="RailScrollViewer" Grid.Row="2"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto"
                                  AllowAutoHide="False"
                                  Padding="0,0,0,4">
                        <ItemsControl x:Name="RailLibraryItems" ItemsSource="{Binding RailLibraries}"
                                      ItemTemplate="{DynamicResource LibraryRailItemTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- 筛选段：常驻可见（即使上方筛选行收起），点击展开筛选行 -->
                    <StackPanel Grid.Row="3" Margin="0,4,0,10">
                        <Border Height="1" Margin="0,0,0,8" Background="{DynamicResource BorderSubtleBrush}"/>
                        <TextBlock Classes="railSection" Text="筛选" Margin="14,0,12,6"/>
                        <Button Classes="railFilterRow" Tag="group" Click="RailFilterRow_Click"
                                auto:AutomationProperties.Name="展开分组筛选">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <PathIcon Grid.Column="0" Width="14" Height="14" Margin="0,0,9,0" VerticalAlignment="Center"
                                          Foreground="{DynamicResource TextTertiaryBrush}"
                                          Data="F0 M3 3h8v8H3V3zm10 0h8v8h-8V3zM3 13h8v8H3v-8zm10 0h8v8h-8v-8z"/>
                                <TextBlock Grid.Column="1" Text="分组" Classes="cell" VerticalAlignment="Center"/>
                                <Border Grid.Column="2" MinWidth="18" Height="16" CornerRadius="8" Padding="5,0"
                                        Background="{DynamicResource AppAccentSoftBrush}"
                                        IsVisible="{Binding HasGroupFilter}" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding GroupSelectedCount}" FontSize="{DynamicResource CaptionFontSize}"
                                               Foreground="{DynamicResource AppAccentTextBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Button>
                        <Button Classes="railFilterRow" Tag="tag" Click="RailFilterRow_Click"
                                auto:AutomationProperties.Name="展开标签筛选">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <PathIcon Grid.Column="0" Width="14" Height="14" Margin="0,0,9,0" VerticalAlignment="Center"
                                          Foreground="{DynamicResource TextTertiaryBrush}"
                                          Data="F0 M11 2H4a2 2 0 0 0-2 2v7l9 9 9-9-9-9zM6.5 7.5a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3z"/>
                                <TextBlock Grid.Column="1" Text="标签" Classes="cell" VerticalAlignment="Center"/>
                                <Border Grid.Column="2" MinWidth="18" Height="16" CornerRadius="8" Padding="5,0"
                                        Background="{DynamicResource AppAccentSoftBrush}"
                                        IsVisible="{Binding HasTagFilter}" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TagSelectedCount}" FontSize="{DynamicResource CaptionFontSize}"
                                               Foreground="{DynamicResource AppAccentTextBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Button>
                        <Button Classes="railFilterRow" Tag="platform" Click="RailFilterRow_Click"
                                auto:AutomationProperties.Name="展开平台筛选">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <PathIcon Grid.Column="0" Width="14" Height="14" Margin="0,0,9,0" VerticalAlignment="Center"
                                          Foreground="{DynamicResource TextTertiaryBrush}"
                                          Data="F0 M3 4h18a1 1 0 0 1 1 1v11a1 1 0 0 1-1 1h-7v2h3v2H7v-2h3v-2H3a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1zm1 2v9h16V6H4z"/>
                                <TextBlock Grid.Column="1" Text="平台" Classes="cell" VerticalAlignment="Center"/>
                                <Border Grid.Column="2" MinWidth="18" Height="16" CornerRadius="8" Padding="5,0"
                                        Background="{DynamicResource AppAccentSoftBrush}"
                                        IsVisible="{Binding HasPlatformFilter}" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding PlatformSelectedCount}" FontSize="{DynamicResource CaptionFontSize}"
                                               Foreground="{DynamicResource AppAccentTextBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Button>
                        <Button Classes="railFilterRow" Tag="source" Click="RailFilterRow_Click"
                                auto:AutomationProperties.Name="展开来源筛选">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <PathIcon Grid.Column="0" Width="14" Height="14" Margin="0,0,9,0" VerticalAlignment="Center"
                                          Foreground="{DynamicResource TextTertiaryBrush}"
                                          Data="F0 M11 3h2v9.2l3.6-3.6 1.4 1.4L12 16.6 5.9 10l1.4-1.4L11 12.2V3zM4 19h16v2H4z"/>
                                <TextBlock Grid.Column="1" Text="来源" Classes="cell" VerticalAlignment="Center"/>
                                <Border Grid.Column="2" MinWidth="18" Height="16" CornerRadius="8" Padding="5,0"
                                        Background="{DynamicResource AppAccentSoftBrush}"
                                        IsVisible="{Binding HasSourceFilter}" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SourceSelectedCount}" FontSize="{DynamicResource CaptionFontSize}"
                                               Foreground="{DynamicResource AppAccentTextBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Button>
                    </StackPanel>

                    <Button Grid.Row="4" Classes="ghostBtn" Click="RetryLibraries_Click"
                            Content="发布库加载失败 · 重试" Margin="12,0,12,10" MinHeight="32" Padding="8,4"
                            FontSize="{DynamicResource AuxFontSize}"
                            IsVisible="{Binding LibrariesLoadFailed}"
                            auto:AutomationProperties.Name="重新加载发布库"/>
                </Grid>
            </Border>

            <!-- 内容区：移动库选择条 / 筛选行 / 表头 / 结果列表 -->
            <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto,*">
                <Grid x:Name="MobileLibraryBar" Grid.Row="0" IsVisible="False" ColumnDefinitions="*,*"
                      ColumnSpacing="8" Margin="12,10,12,0">
                    <Button x:Name="MobileLibraryPicker" Grid.Column="0" Classes="ghostBtn"
                            MinHeight="44" HorizontalAlignment="Stretch" Click="OpenLibraryDrawer_Click"
                            auto:AutomationProperties.Name="选择发布库">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <PathIcon Grid.Column="0" Data="M3 5h7l2 2h9a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1z"
                                      Width="16" Height="16" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Grid.Column="1" Text="{Binding CurrentLibraryName}" VerticalAlignment="Center"
                                       FontSize="{DynamicResource BodyFontSize}" Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis" MaxLines="1"
                                       auto:AutomationProperties.LiveSetting="Polite"/>
                            <TextBlock Grid.Column="2" Text="⌄" VerticalAlignment="Center"
                                       FontSize="{DynamicResource BodyFontSize}" Foreground="{DynamicResource TextTertiaryBrush}"/>
                        </Grid>
                    </Button>
                    <Button x:Name="MobileFilterCompact" Grid.Column="1" Classes="ghostBtn"
                            MinHeight="44" HorizontalAlignment="Stretch" Click="OpenFilterPanel_Click"
                            auto:AutomationProperties.Name="打开筛选面板">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <PathIcon Grid.Column="0" Data="M3 5h18v2l-7 7v5l-4 2v-7L3 7V5z"
                                      Width="16" Height="16" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Grid.Column="1" Text="筛选" VerticalAlignment="Center"
                                       FontSize="{DynamicResource BodyFontSize}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <Border Grid.Column="2" MinWidth="22" Height="22" CornerRadius="11"
                                    Background="{DynamicResource AppAccentBrush}" IsVisible="{Binding HasActiveFilters}">
                                <TextBlock Text="{Binding ActiveFilterCount}" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" FontSize="{DynamicResource CaptionFontSize}"
                                           Foreground="{DynamicResource OnAccentBrush}"/>
                            </Border>
                        </Grid>
                    </Button>
                </Grid>

                <!-- 筛选行：默认只看一行 header（四维 chip 默认隐藏） -->
                <Border x:Name="FilterRowHost" Grid.Row="1" Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="0,0,0,1" Padding="16,8,16,10">
                    <Grid RowDefinitions="Auto,Auto" RowSpacing="6">
                        <!-- 筛选行 header：整行可点；右侧 44×44 箭头按钮承担键盘操作 -->
                        <Grid x:Name="FilterHeader" Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto"
                              ColumnSpacing="8" PointerPressed="FilterHeader_PointerPressed"
                              Cursor="Hand" ToolTip.Tip="{Binding FilterToggleName}">
                            <TextBlock Grid.Column="0" Text="筛选" FontSize="{DynamicResource SectionTitleFontSize}"
                                       FontWeight="{DynamicResource WeightSemiBold}"
                                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" MinWidth="20" Height="20" CornerRadius="10"
                                    Background="{DynamicResource AppAccentBrush}"
                                    IsVisible="{Binding HasActiveFilters}" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ActiveFilterCount}" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" FontSize="{DynamicResource CaptionFontSize}"
                                           Foreground="{DynamicResource OnAccentBrush}"/>
                            </Border>
                            <TextBlock Grid.Column="2" Text="{Binding FilterStatusText}"
                                       FontSize="{DynamicResource CaptionFontSize}"
                                       Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                <Button Classes="ghostBtn" Content="清除全部" Padding="8,2" MinHeight="26"
                                        Click="ClearFilters_Click" IsVisible="{Binding HasActiveFilters}"
                                        auto:AutomationProperties.Name="清除全部筛选"/>
                                <Button x:Name="FilterCollapseButton" Classes="iconBtn"
                                        Click="ToggleFilters_Click"
                                        auto:AutomationProperties.Name="{Binding FilterToggleName}"
                                        auto:AutomationProperties.LiveSetting="Polite">
                                    <Panel>
                                        <!-- 收起态 ∨（内容在下方，点开向下展开）；展开态 ∧ -->
                                        <PathIcon IsVisible="{Binding IsFiltersCollapsed}"
                                                  Data="F0 M12 15.5 5.5 9l1.4-1.4L12 12.7l5.1-5.1L18.5 9z"
                                                  Width="16" Height="16" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <PathIcon IsVisible="{Binding !IsFiltersCollapsed}"
                                                  Data="F0 M12 8.5 18.5 15l-1.4 1.4L12 11.3 6.9 16.4 5.5 15z"
                                                  Width="16" Height="16" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </Panel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- 桌面：四维常驻（高度不足时由代码切换为二维/按钮）；首帧先隐藏，由 ApplyFilterVisibility 按折叠态决定 -->
                        <Border x:Name="DesktopFilterBar" Grid.Row="1" IsVisible="False">
                            <StackPanel Spacing="6">
                                <Grid ColumnDefinitions="56,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="分组" VerticalAlignment="Top" Margin="0,8,0,0"
                                               FontSize="{DynamicResource CaptionFontSize}" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                    <ItemsControl Grid.Row="0" Grid.Column="1" ItemsSource="{Binding StickyGroupChips}"
                                                  ItemTemplate="{DynamicResource FilterChipTemplate}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="标签" VerticalAlignment="Top" Margin="0,8,0,0"
                                               FontSize="{DynamicResource CaptionFontSize}" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                    <ItemsControl Grid.Row="1" Grid.Column="1" ItemsSource="{Binding StickyTagChips}"
                                                  ItemTemplate="{DynamicResource FilterChipTemplate}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="平台" VerticalAlignment="Top" Margin="0,8,0,0"
                                               FontSize="{DynamicResource CaptionFontSize}" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                    <ItemsControl Grid.Row="2" Grid.Column="1" ItemsSource="{Binding StickyPlatformChips}"
                                                  ItemTemplate="{DynamicResource FilterChipTemplate}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="来源" VerticalAlignment="Top" Margin="0,8,0,0"
                                               FontSize="{DynamicResource CaptionFontSize}" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                    <ItemsControl Grid.Row="3" Grid.Column="1" ItemsSource="{Binding StickySourceChips}"
                                                  ItemTemplate="{DynamicResource FilterChipTemplate}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </Grid>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                                    <Button Classes="ghostBtn" Content="更多筛选" Click="OpenFilterPanel_Click"
                                            IsVisible="{Binding HasMoreFilters}"
                                            auto:AutomationProperties.Name="打开更多筛选"/>
                                    <Button Classes="ghostBtn" Content="清除全部" IsVisible="{Binding HasActiveFilters}"
                                            Click="ClearFilters_Click" auto:AutomationProperties.Name="清除全部筛选"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 二维 + 更多：平板/低高度档 -->
                        <Border x:Name="TabletFilterBar" Grid.Row="1" IsVisible="False">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="56,*" RowDefinitions="Auto,Auto" RowSpacing="6">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="分组" VerticalAlignment="Top" Margin="0,8,0,0"
                                               FontSize="{DynamicResource CaptionFontSize}" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                    <ItemsControl Grid.Row="0" Grid.Column="1" ItemsSource="{Binding StickyGroupChips}"
                                                  ItemTemplate="{DynamicResource FilterChipTemplate}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="平台" VerticalAlignment="Top" Margin="0,8,0,0"
                                               FontSize="{DynamicResource CaptionFontSize}" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                    <ItemsControl Grid.Row="1" Grid.Column="1" ItemsSource="{Binding StickyPlatformChips}"
                                                  ItemTemplate="{DynamicResource FilterChipTemplate}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </Grid>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                                    <Button Classes="ghostBtn" Content="清除全部" IsVisible="{Binding HasActiveFilters}"
                                            Click="ClearFilters_Click" auto:AutomationProperties.Name="清除全部筛选"/>
                                    <Button Classes="ghostBtn" Content="更多筛选" Click="OpenFilterPanel_Click"
                                            auto:AutomationProperties.Name="打开更多筛选"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 按钮态：窗口高度 <560 的桌面/平板 -->
                        <Button x:Name="MobileFilterButton" Grid.Row="1" IsVisible="False" Classes="ghostBtn"
                                HorizontalAlignment="Left" MinHeight="40" Click="OpenFilterPanel_Click"
                                auto:AutomationProperties.Name="打开筛选面板">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <PathIcon Data="M3 5h18v2l-7 7v5l-4 2v-7L3 7V5z"
                                          Width="16" Height="16" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="筛选" VerticalAlignment="Center"
                                           FontSize="{DynamicResource BodyFontSize}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <Border MinWidth="22" Height="22" CornerRadius="11"
                                        Background="{DynamicResource AppAccentBrush}" IsVisible="{Binding HasActiveFilters}">
                                    <TextBlock Text="{Binding ActiveFilterCount}" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" FontSize="{DynamicResource CaptionFontSize}"
                                               Foreground="{DynamicResource OnAccentBrush}"/>
                                </Border>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- 表头：与行共用同一套列宽资源，隐藏列时列宽自动归零 -->
                <Border x:Name="TableHeader" Grid.Row="2" Classes="tableHeader"
                        Height="{DynamicResource TableHeaderHeight}" IsVisible="{Binding HasCards}">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto" Margin="12,0,12,0">
                        <Border Grid.Column="0" Width="{DynamicResource ColIndexWidth}"
                                IsVisible="{Binding ShowIndexColumn}">
                            <TextBlock Classes="th" Text="#" TextAlignment="Right"/>
                        </Border>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                                    Margin="6,0,0,0" ToolTip.Tip="按后台 SortOrder 排序">
                            <TextBlock Classes="th" Text="名称"/>
                            <PathIcon Data="F0 M12 8l6 8H6z" Width="8" Height="8"
                                      Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border Grid.Column="2" Width="{DynamicResource ColMetaWidth}"
                                IsVisible="{Binding ShowMetaColumn}">
                            <TextBlock Classes="th" Text="分组 · 标签"/>
                        </Border>
                        <Border Grid.Column="3" Width="{DynamicResource ColPlatformWidth}"
                                IsVisible="{Binding ShowPlatformColumn}">
                            <TextBlock Classes="th" Text="平台"/>
                        </Border>
                        <Border Grid.Column="4" Width="{DynamicResource ColSourceWidth}"
                                IsVisible="{Binding ShowSourceColumn}">
                            <TextBlock Classes="th" Text="来源"/>
                        </Border>
                        <Border Grid.Column="5" Width="{DynamicResource ColDateWidth}"
                                IsVisible="{Binding ShowDateColumn}">
                            <TextBlock Classes="th" Text="更新"/>
                        </Border>
                        <Border Grid.Column="6" Width="{DynamicResource ColActionWidth}">
                            <TextBlock Classes="th" Text="操作" TextAlignment="Right"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- 结果列表：唯一滚动层 -->
                <ScrollViewer x:Name="ResultsScrollViewer" Grid.Row="3"
                              Background="{DynamicResource SurfaceBrush}"
                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                              Padding="0,0,0,24">
                    <StackPanel>
                        <ItemsControl x:Name="RowsControl" ItemsSource="{Binding Cards}"
                                      IsVisible="{Binding HasCards}" HorizontalAlignment="Stretch">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:LinkCardViewModel">
                                    <Border Classes="tableRow">
                                        <StackPanel>
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto"
                                                  MinHeight="{DynamicResource TableRowHeight}" Margin="12,0,12,0">
                                                <!-- 序号 -->
                                                <TextBlock Grid.Column="0" Text="{Binding Index}"
                                                           Width="{DynamicResource ColIndexWidth}" TextAlignment="Right"
                                                           FontFamily="{DynamicResource MonoFontFamily}"
                                                           FontSize="{DynamicResource MonoFontSize}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           VerticalAlignment="Center" IsVisible="{Binding ShowIndexColumn}"
                                                           Focusable="False" IsHitTestVisible="False"
                                                           auto:AutomationProperties.Name="{Binding Index, StringFormat=第{0}条}"/>

                                                <!-- 名称：标题（链接图标 + 可点打开） / 网址 + 提取码 -->
                                                <StackPanel Grid.Column="1" Margin="6,7,10,7" VerticalAlignment="Center">
                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                                        <PathIcon Grid.Column="0" Width="13" Height="13" VerticalAlignment="Center"
                                                                  Foreground="{DynamicResource TextTertiaryBrush}"
                                                                  Data="F0 M10.6 13.4a1 1 0 0 1 0-1.4l1.4-1.4a1 1 0 0 1 1.4 0l.7.7 1.4-1.4-.7-.7a3 3 0 0 0-4.2 0l-1.4 1.4a3 3 0 0 0 0 4.2l.7.7 1.4-1.4-.7-.7zM13.4 10.6a1 1 0 0 1 0 1.4l-1.4 1.4a1 1 0 0 1-1.4 0l-.7-.7-1.4 1.4.7.7a3 3 0 0 0 4.2 0l1.4-1.4a3 3 0 0 0 0-4.2l-.7-.7-1.4 1.4.7.7z"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Link.Title}"
                                                                   FontSize="{DynamicResource BodyStrongFontSize}"
                                                                   FontWeight="{DynamicResource WeightMedium}"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   TextTrimming="CharacterEllipsis" MaxLines="1"
                                                                   VerticalAlignment="Center" Cursor="Hand"
                                                                   ToolTip.Tip="{Binding RowTooltip}"
                                                                   Tapped="OpenTitle_Tapped"
                                                                   auto:AutomationProperties.Name="{Binding Link.Title}"/>
                                                    </Grid>
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="19,2,0,0">
                                                        <TextBlock Grid.Column="0" Text="{Binding Link.Url}"
                                                                   FontFamily="{DynamicResource MonoFontFamily}"
                                                                   FontSize="{DynamicResource MonoFontSize}"
                                                                   Foreground="{DynamicResource InfoTextBrush}"
                                                                   TextTrimming="CharacterEllipsis" MaxLines="1"
                                                                   VerticalAlignment="Center" Focusable="False" Cursor="Hand"
                                                                   ToolTip.Tip="{Binding Link.Url, StringFormat=打开链接：{0}}"
                                                                   Tapped="OpenLink_Tapped"
                                                                   IsVisible="{Binding HasUrl}"
                                                                   auto:AutomationProperties.Name="{Binding Link.Url}"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding ExtractText}"
                                                                   FontFamily="{DynamicResource MonoFontFamily}"
                                                                   FontSize="{DynamicResource MonoFontSize}"
                                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                                   VerticalAlignment="Center" IsVisible="{Binding HasExtractCode}"/>
                                                    </Grid>
                                                </StackPanel>

                                                <!-- 分组 · 标签 -->
                                                <Border Grid.Column="2" Width="{DynamicResource ColMetaWidth}"
                                                        IsVisible="{Binding ShowMetaColumn}">
                                                    <TextBlock Classes="cell" Text="{Binding MetaText}"
                                                               Margin="0,0,12,0" ToolTip.Tip="{Binding MetaText}"/>
                                                </Border>
                                                <!-- 平台：空值也占位，保证列不因内容缺失而错位 -->
                                                <Border Grid.Column="3" Width="{DynamicResource ColPlatformWidth}"
                                                        IsVisible="{Binding ShowPlatformColumn}">
                                                    <TextBlock Classes="cell" Text="{Binding PlatformDisplay}" Margin="0,0,8,0"
                                                               ToolTip.Tip="{Binding PlatformDisplay}"/>
                                                </Border>
                                                <!-- 来源 -->
                                                <Border Grid.Column="4" Width="{DynamicResource ColSourceWidth}"
                                                        IsVisible="{Binding ShowSourceColumn}">
                                                    <TextBlock Classes="cell" Text="{Binding Link.ImportSourceLabel}" Margin="0,0,8,0"/>
                                                </Border>
                                                <!-- 更新 -->
                                                <Border Grid.Column="5" Width="{DynamicResource ColDateWidth}"
                                                        IsVisible="{Binding ShowDateColumn}">
                                                    <TextBlock Classes="cell" Text="{Binding CreatedText}" Margin="0,0,8,0"
                                                               FontFamily="{DynamicResource MonoFontFamily}"
                                                               FontSize="{DynamicResource MonoFontSize}"/>
                                                </Border>

                                                <!-- 操作：详情 / 复制 / 打开（窄屏只留详情） -->
                                                <Border Grid.Column="6" Width="{DynamicResource ColActionWidth}">
                                                    <StackPanel Orientation="Horizontal" Spacing="2"
                                                                HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <Button Classes="cardAction" Click="ToggleDetail_Click"
                                                                IsVisible="{Binding HasDetail}"
                                                                ToolTip.Tip="{Binding DetailToggleName}"
                                                                auto:AutomationProperties.Name="{Binding DetailToggleName}">
                                                            <Panel>
                                                                <PathIcon IsVisible="{Binding !IsDetailExpanded}"
                                                                          Data="F0 M9 6l6 6-6 6-1.4-1.4L12.2 12 7.6 7.4z"
                                                                          Width="13" Height="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                                <PathIcon IsVisible="{Binding IsDetailExpanded}"
                                                                          Data="F0 M6 9l6 6 6-6-1.4-1.4L12 12.2 7.4 7.6z"
                                                                          Width="13" Height="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                            </Panel>
                                                        </Button>
                                                        <Button Classes="cardAction" Tag="{Binding}" Click="CopyUrl_Click"
                                                                IsVisible="{Binding ShowCopyAction}"
                                                                ToolTip.Tip="复制链接"
                                                                auto:AutomationProperties.Name="{Binding Link.Title, StringFormat=复制主链接：{0}}">
                                                            <PathIcon Data="F0 M16 1H4a2 2 0 0 0-2 2v14h2V3h12V1zm3 4H8a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h11a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2zm0 16H8V7h11v14z"
                                                                      Width="13" Height="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                        </Button>
                                                        <Button Classes="cardAction" Tag="{Binding}" Click="OpenLink_Click"
                                                                IsVisible="{Binding ShowOpenAction}"
                                                                ToolTip.Tip="在浏览器打开"
                                                                auto:AutomationProperties.Name="{Binding Link.Title, StringFormat=打开链接：{0}}">
                                                            <PathIcon Data="F0 M19 19H5V5h6V3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-6h-2v6zM14 3v2h3.59l-8.3 8.3 1.42 1.42 8.29-8.3V16h2V3h-7z"
                                                                      Width="13" Height="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                        </Button>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>

                                            <!-- 行内详情：摘要 / 提取码 / 到期 / 附属链接 -->
                                            <Border IsVisible="{Binding IsDetailExpanded}" Padding="51,0,12,10" Margin="0,-4,0,0">
                                                <StackPanel Spacing="6">
                                                    <TextBlock Text="{Binding Link.Summary}" TextWrapping="Wrap"
                                                               FontSize="{DynamicResource AuxFontSize}"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               LineHeight="19" IsVisible="{Binding HasSummary}"/>
                                                    <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasExtractCode}">
                                                        <TextBlock Text="提取码" FontSize="{DynamicResource CaptionFontSize}"
                                                                   Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Link.ExtractCode}" FontFamily="{DynamicResource MonoFontFamily}"
                                                                   FontSize="{DynamicResource MonoFontSize}" Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   VerticalAlignment="Center"/>
                                                        <Button Classes="cardAction" Tag="{Binding}" Click="CopyCode_Click"
                                                                auto:AutomationProperties.Name="{Binding Link.Title, StringFormat=复制提取码：{0}}">
                                                            <PathIcon Data="F0 M16 1H4a2 2 0 0 0-2 2v14h2V3h12V1zm3 4H8a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h11a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2zm0 16H8V7h11v14z"
                                                                      Width="12" Height="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                        </Button>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Link.ExpireAt}" FontSize="{DynamicResource CaptionFontSize}"
                                                               Foreground="{DynamicResource WarningTextBrush}"
                                                               IsVisible="{Binding HasExpireAt}"/>
                                                    <WrapPanel IsVisible="{Binding HasSubLinks}" ItemSpacing="8" LineSpacing="4">
                                                        <TextBlock Text="附属链接" FontSize="{DynamicResource CaptionFontSize}"
                                                                   Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                                                        <ItemsControl ItemsSource="{Binding SubLinks}">
                                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemSpacing="8" LineSpacing="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:SubLinkVm">
                                                                    <Button Classes="subLink" Tag="{Binding Url}" Click="OpenSubLink_Click"
                                                                            ToolTip.Tip="{Binding Url}"
                                                                            auto:AutomationProperties.Name="{Binding Display}">
                                                                        <TextBlock Text="{Binding Display}" FontSize="{DynamicResource CaptionFontSize}"
                                                                                   Foreground="{DynamicResource InfoTextBrush}"
                                                                                   TextTrimming="CharacterEllipsis" MaxLines="1" MaxWidth="320"
                                                                                   ToolTip.Tip="{Binding Display}"/>
                                                                    </Button>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 骨架屏：与行同高的细条占位 -->
                        <ItemsControl ItemsSource="{Binding SkeletonItems}" IsVisible="{Binding ShowSkeleton}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Height="{DynamicResource TableRowHeight}"
                                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                                        <StackPanel Margin="12,0" VerticalAlignment="Center" Spacing="6">
                                            <Border Classes="skeletonBlock" Height="12" Width="220" HorizontalAlignment="Left"/>
                                            <Border Classes="skeletonBlock" Height="9" Width="320" HorizontalAlignment="Left"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 空态 / 错误态 -->
                        <Border Margin="16" Padding="40,48" Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                CornerRadius="{DynamicResource CardRadius}" IsVisible="{Binding ShowEmpty}"
                                HorizontalAlignment="Stretch">
                            <StackPanel HorizontalAlignment="Center" Spacing="10">
                                <PathIcon Data="F0 M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2zm0 2v8h4l2 3h4l2-3h4V6H4z"
                                          Width="40" Height="40" Foreground="{DynamicResource TextDisabledBrush}"
                                          HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding EmptyTitle}" FontSize="{DynamicResource SectionTitleFontSize}"
                                           FontWeight="{DynamicResource WeightMedium}" Foreground="{DynamicResource TextPrimaryBrush}"
                                           HorizontalAlignment="Center" TextAlignment="Center"/>
                                <TextBlock Text="{Binding EmptyHint}" FontSize="{DynamicResource AuxFontSize}"
                                           Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" Margin="0,6,0,0">
                                    <Button Classes="ghostBtn" Content="清除搜索" Click="ClearSearch_Click"
                                            IsVisible="{Binding ShowClearSearchHint}"/>
                                    <Button Classes="ghostBtn" Content="清除筛选" Click="ClearFilters_Click"
                                            IsVisible="{Binding ShowClearFiltersHint}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Margin="16" Padding="32,40" Background="{DynamicResource ErrorBgBrush}"
                                BorderBrush="{DynamicResource ErrorBaseBrush}" BorderThickness="1"
                                CornerRadius="{DynamicResource CardRadius}" IsVisible="{Binding IsError}"
                                HorizontalAlignment="Stretch">
                            <StackPanel HorizontalAlignment="Center" Spacing="10">
                                <PathIcon Data="F0 M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm0 2a8 8 0 1 1 0 16 8 8 0 0 1 0-16zm-1 4h2v6h-2V8zm0 7h2v2h-2v-2z"
                                          Width="36" Height="36" Foreground="{DynamicResource ErrorBaseBrush}"
                                          HorizontalAlignment="Center"/>
                                <TextBlock Text="无法连接到后端服务" FontSize="{DynamicResource SectionTitleFontSize}"
                                           FontWeight="{DynamicResource WeightSemiBold}" Foreground="{DynamicResource ErrorTextBrush}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding ErrorReason}" FontSize="{DynamicResource AuxFontSize}"
                                           Foreground="{DynamicResource ErrorTextBrush}" TextWrapping="Wrap"
                                           HorizontalAlignment="Center" TextAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" Margin="0,6,0,0">
                                    <Button Classes="primary" Content="重试" Click="Retry_Click"/>
                                    <Button Classes="ghostBtn" Content="修改地址" Click="OpenSettingsFromError_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 移动端：结果区底部固定「加载更多」条（append 非替换） -->
                        <Border IsVisible="{Binding IsMobile}" Padding="12,12,12,0">
                            <Button Classes="ghostBtn" Content="{Binding MobileLoadMoreText}" Click="LoadMore_Click"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" MinHeight="44"
                                    IsEnabled="{Binding CanLoadMore}" auto:AutomationProperties.Name="加载更多"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ============ Row2：进度条 + 状态栏 ============ -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceSunkenBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0">
            <StackPanel>
                <!-- 分页进度：整宽细条，对应参考界面的底部占用条 -->
                <ProgressBar x:Name="PageProgressBar" Height="3" Minimum="0" Maximum="100"
                             Value="{Binding ProgressPercent}" CornerRadius="0"
                             Background="{DynamicResource BorderSubtleBrush}"
                             Foreground="{DynamicResource AppAccentBrush}"
                             IsHitTestVisible="False" IsVisible="{Binding HasProgress}"/>
                <Grid Height="34" ColumnDefinitions="*,Auto,*" Margin="14,0">
                    <!-- 桌面/平板：共 N 条结果 · 每页 [P▾] 条；移动：只留共 N 条 · X/Y 页 -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Status}" FontSize="{DynamicResource CaptionFontSize}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                                   IsVisible="{Binding !IsMobile}"
                                   auto:AutomationProperties.Name="结果数量"
                                   auto:AutomationProperties.LiveSetting="Polite"/>
                        <TextBlock Text="{Binding MobileStatus}" FontSize="{DynamicResource CaptionFontSize}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                                   IsVisible="{Binding IsMobile}"/>
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                                    IsVisible="{Binding !IsMobile}">
                            <TextBlock Text="· 每页" FontSize="{DynamicResource CaptionFontSize}"
                                       Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                            <Button x:Name="PageSizeButton" Classes="pageSizeTrigger" Content="{Binding PageSize}"
                                    MinHeight="24" Padding="8,1" MinWidth="44"
                                    auto:AutomationProperties.Name="选择每页条数">
                                <Button.Flyout>
                                    <Flyout Placement="Top">
                                        <Border Background="{DynamicResource SurfaceBrush}"
                                                BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                                                CornerRadius="{DynamicResource PopoverRadius}" Padding="4">
                                            <ItemsControl ItemsSource="{Binding PageSizeOptions}"
                                                          ItemTemplate="{DynamicResource PageSizeOptionTemplate}">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </Border>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                            <TextBlock Text="条" FontSize="{DynamicResource CaptionFontSize}"
                                       Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- 桌面/平板紧凑翻页控件；首尾禁用 -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                                IsVisible="{Binding !IsMobile}">
                        <Button Classes="pageNavBtn" Content="‹ 上一页" Click="PrevPage_Click"
                                IsEnabled="{Binding CanGoPrevious}" auto:AutomationProperties.Name="上一页"/>
                        <TextBlock Text="{Binding PageIndicator}" FontSize="{DynamicResource CaptionFontSize}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        <Button Classes="pageNavBtn" Content="下一页 ›" Click="NextPage_Click"
                                IsEnabled="{Binding CanGoNext}" auto:AutomationProperties.Name="下一页"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <TextBlock Text="{Binding ProgressText}" FontSize="{DynamicResource CaptionFontSize}"
                                   FontWeight="{DynamicResource WeightMedium}"
                                   Foreground="{DynamicResource AppAccentTextBrush}" VerticalAlignment="Center"
                                   IsVisible="{Binding HasProgress}"/>
                        <Ellipse Width="7" Height="7" Fill="{DynamicResource SuccessBaseBrush}" IsVisible="{Binding IsConnected}" VerticalAlignment="Center"/>
                        <Ellipse Width="7" Height="7" Fill="{DynamicResource WarningBaseBrush}" IsVisible="{Binding IsConnecting}" VerticalAlignment="Center"/>
                        <Ellipse Width="7" Height="7" Fill="{DynamicResource ErrorBaseBrush}" IsVisible="{Binding IsDisconnected}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ConnectionText}" FontSize="{DynamicResource CaptionFontSize}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding UpdatedText}" FontSize="{DynamicResource CaptionFontSize}"
                                   Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"
                                   IsVisible="{Binding !IsMobile}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ============ 浮层：移动库抽屉（底部弹出，SurfaceBrush 白面板） ============ -->
        <Border x:Name="LibraryDrawer" Grid.RowSpan="3" IsVisible="False"
                Background="{DynamicResource ScrimBrush}" ZIndex="25"
                PointerPressed="LibraryDrawerScrim_PointerPressed">
            <Border x:Name="LibraryDrawerPanel" Width="320" MaxHeight="560"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Focusable="True"
                    Background="{DynamicResource SurfaceBrush}" CornerRadius="12,12,0,0" Padding="0,0,0,8"
                    auto:AutomationProperties.Name="选择发布库抽屉">
                <Grid RowDefinitions="Auto,Auto,*">
                    <TextBlock Grid.Row="0" Text="选择发布库" Margin="16,20,16,12"
                               FontSize="{DynamicResource SectionTitleFontSize}"
                               FontWeight="{DynamicResource WeightSemiBold}"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <Border Grid.Row="1" Height="1" Background="{DynamicResource BorderSubtleBrush}" Margin="16,0,16,8"/>
                    <!-- 抽屉不做吸顶（弹出层可视高度有限，重新打开即回顶），
                         「全部发布库」作为列表第一项；条目样式与 rail 完全一致 -->
                    <ScrollViewer x:Name="DrawerScrollViewer" Grid.Row="2"
                                  HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                  Padding="0,0,0,4">
                        <ItemsControl x:Name="DrawerLibraryItems" ItemsSource="{Binding LibraryChips}"
                                      ItemTemplate="{DynamicResource LibraryRailItemTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Border>

        <!-- ============ 浮层：筛选面板（平板 / 移动） ============ -->
        <Border x:Name="FilterOverlay" Grid.RowSpan="3" IsVisible="False"
                Background="{DynamicResource ScrimBrush}" ZIndex="20">
            <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16">
                <ContentControl Template="{DynamicResource FilterPanelTemplate}"/>
            </Grid>
        </Border>

        <!-- ============ 浮层：设置 - 桌面 Popover 360 ============ -->
        <Border x:Name="SettingsPopover" Grid.RowSpan="3" IsVisible="False" ZIndex="30"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,58,16,0"
                Width="{DynamicResource SettingsPopoverWidth}">
            <ContentControl Template="{DynamicResource SettingsFormTemplate}"/>
        </Border>

        <!-- ============ 浮层：设置 - 平板 Dialog 420 ============ -->
        <Border x:Name="SettingsDialogScrim" Grid.RowSpan="3" IsVisible="False" ZIndex="30"
                Background="{DynamicResource ScrimBrush}">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="{DynamicResource SettingsDialogWidth}" Margin="16">
                <ContentControl Template="{DynamicResource SettingsFormTemplate}"/>
            </Border>
        </Border>

        <!-- ============ 浮层：设置 - 移动全屏 ============ -->
        <Border x:Name="SettingsFull" Grid.RowSpan="3" IsVisible="False" ZIndex="40"
                Background="{DynamicResource AppBackgroundBrush}">
            <ContentControl Template="{DynamicResource SettingsFormTemplate}" VerticalAlignment="Top" Margin="12"/>
        </Border>

        <!-- ============ Toast：底部居中距底 24 ============ -->
        <ItemsControl x:Name="ToastHost" Grid.RowSpan="3" ZIndex="50" ItemsSource="{Binding Toasts}"
                      ItemTemplate="{DynamicResource ToastTemplate}"
                      HorizontalAlignment="Center" VerticalAlignment="Bottom"
                      Margin="0,0,0,44" MaxWidth="420"
                      auto:AutomationProperties.Name="操作提示"
                      auto:AutomationProperties.LiveSetting="Polite"/>
    </Grid>
</Window>
