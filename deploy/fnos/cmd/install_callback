#!/bin/bash
# 安装完成：生成运行配置（JWT 随机密钥），确保数据目录存在
set -euo pipefail

VAR="${TRIM_PKGVAR:?缺少 TRIM_PKGVAR}"
CFG="$VAR/appsettings.Production.json"

mkdir -p "$VAR/data"

if [ ! -f "$CFG" ]; then
  SECRET="$(head -c 48 /dev/urandom | base64 | tr -d '\n')"
  cat > "$CFG" <<JSON
{
  "Database": { "Provider": "sqlite", "Path": "/app/data/durlinks.db" },
  "Kestrel": { "Host": "0.0.0.0" },
  "Ports": { "Public": 8789, "Admin": 8788 },
  "Jwt": { "Secret": "$SECRET" },
  "AllowedHosts": "*"
}
JSON
  chmod 600 "$CFG"
fi

exit 0
