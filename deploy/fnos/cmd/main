#!/bin/bash
# fnOS 生命周期：start/stop 由应用中心管理 docker 项目，这里只做状态与兜底
set -u

CONTAINER="durlinks-demo-api"

is_running() {
  docker inspect -f '{{.State.Running}}' "$CONTAINER" 2>/dev/null | grep -q '^true$'
}

case "$1" in
  start)
    if ! is_running; then
      docker start "$CONTAINER" >/dev/null 2>&1 || true
    fi
    exit 0
    ;;
  stop)
    if is_running; then
      docker stop "$CONTAINER" >/dev/null 2>&1 || true
    fi
    exit 0
    ;;
  status)
    if is_running; then exit 0; else exit 3; fi
    ;;
  *)
    exit 1
    ;;
esac
