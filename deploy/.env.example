# 复制为 deploy/.env 后修改；该文件含真实口令，已在 .gitignore 中排除
# PostgreSQL 生产编排（docker-compose.prod.yml）必填这四项
PG_DATABASE=durlinks_demo
PG_USER=durlinks_demo
PG_PASSWORD=change-me-to-a-strong-password
# 至少 32 位；生成：openssl rand -base64 48（占位符未替换时服务端会拒绝启动）
JWT_SECRET=CHANGE_ME_openssl_rand_base64_48

# 可选：镜像名（默认本地构建 durlinks-demo:latest）
API_IMAGE=durlinks-demo:latest
